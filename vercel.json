{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --sourcemap --outfile=dist/server.vercel.cjs",
  "outputDirectory": "dist",
  "functions": {
    "api/index.mjs": {
      "includeFiles": "dist/server.vercel.cjs"
    }
  },
  "rewrites": [
    { "source": "/api/:match*", "destination": "/api" },
    { "source": "/auth/:match*", "destination": "/api" }
  ]
}
