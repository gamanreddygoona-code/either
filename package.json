{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "desktop": "electron electron/main.cjs",
    "desktop:dev": "concurrently \"npm run dev\" \"wait-on http://127.0.0.1:3000 && electron electron/main.cjs\"",
    "dist:desktop": "npm run build && electron-builder --win --x64",
    "dist:desktop:portable": "npm run build && electron-builder --win portable --x64"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@vitejs/plugin-react": "^5.0.4",
    "archiver": "^8.0.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.18.0",
    "googleapis": "^176.0.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "three": "^0.185.1",
    "vanilla-tilt": "^1.8.1",
    "vanta": "^0.5.24",
    "vite": "^6.2.3",
    "zdog": "^1.1.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.4",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "puppeteer-core": "^25.9.0",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.23.12",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vite-plugin-pwa": "^1.3.0",
    "wait-on": "^8.0.5",
    "workbox-window": "^7.4.1"
  },
  "build": {
    "appId": "com.either.workspace",
    "productName": "Either AI Workspace",
    "copyright": "Copyright © 2026 Either AI",
    "directories": {
      "output": "release",
      "buildResources": "public"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/**/*",
      "package.json",
      ".servers.json",
      ".env.example"
    ],
    "extraResources": [
      {
        "from": "dist/",
        "to": "dist/"
      },
      {
        "from": ".servers.json",
        "to": ".servers.json"
      }
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "public/icons/icon-512.png",
      "artifactName": "Either-AI-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Either AI Workspace"
    },
    "portable": {
      "artifactName": "Either-AI-Workspace.exe"
    }
  }
}
