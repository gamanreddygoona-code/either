      replacement_content: "import React, { useState, useEffect } from \"react\";\nimport { Header } from \"./components/Header\";\nimport { CatalogView } from \"./components/CatalogView\";\nimport { ComparisonMatrix } from \"./components/ComparisonMatrix\";\nimport { SwarmSimulator } from \"./components/SwarmSimulator\";\nimport { AIResearchAdvisor } from \"./components/AIResearchAdvisor\";\nimport { StackRecommender } from \"./components/StackRecommender\";\nimport { SWARM_UI_PROJECTS } from \"./data/swarmProjects\";\nimport { SwarmUIProject } from \"./types\";\nimport { Bot, Layers, Sparkles, Compass, ShieldCheck } from \"lucide-react\";\n\nexport default function App() {\n  const [activeTab, setActiveTab] = useState<\"catalog\" | \"compare\" | \"simulator\" | \"advisor\" | \"recommender\">(\"catalog\");\n  const [selectedForCompare, setSelectedForCompare] = useState<string[]>([\"agency-swarm\", \"autogen-studio\", \"langflow\"]);\n  const [advisorInitialPrompt, setAdvisorInitialPrompt] = useState<string>(\"\");\n  const [serverStatus, setServerStatus] = useState<{ status: string; hasApiKey: boolean } | null>(null);\n\n  // Check backend server health\n  useEffect(() => {\n    fetch(\"/api/health\")\n      .then((res) => res.json())\n      .then((data) => setServerStatus(data))\n      .catch((err) => {\n        console.warn(\"Server health check:\", err);\n        setServerStatus({ status: \"offline\", hasApiKey: false });\n      });\n  }, []);\n\n  const handleToggleCompare = (projectId: string) => {\n    setSelectedForCompare((prev) => {\n      if (prev.includes(projectId)) {\n        return prev.filter((id) => id !== projectId);\n      } else {\n        if (prev.length >= 4) {\n          alert(\"You can compare up to 4 frameworks simultaneously.\");\n          return prev;\n        }\n        return [...prev, projectId];\n      }\n    });\n  };\n\n  const handleClearCompare = () => {\n    setSelectedForCompare([]);\n  };\n\n  const handleSelectPresets = (ids: string[]) => {\n    setSelectedForCompare(ids);\n    setActiveTab(\"compare\");\n  };\n\n  const handleOpenAdvisorWithProject = (project: SwarmUIProject) => {\n    setAdvisorInitialPrompt(`Provide an in-depth architectural evaluation and setup guide for ${project.name} (${project.repo}). How does it compare to other open-source swarm UIs?`);\n    setActiveTab(\"advisor\");\n  };\n\n  return (\n    <div className=\"min-h-screen bg-slate-950 text-slate-100 flex flex-col font-sans antialiased selection:bg-indigo-500 selection:text-white\">\n      {/* App Header */}\n      <Header\n        activeTab={activeTab}\n        setActiveTab={setActiveTab}\n        serverStatus={serverStatus}\n      />\n\n      {/* Main Content Area */}\n      <main className=\"flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-8\">\n        {activeTab === \"catalog\" && (\n          <CatalogView\n            projects={SWARM_UI_PROJECTS}\n            onSelectProject={(project) => handleOpenAdvisorWithProject(project)}\n            selectedForCompare={selectedForCompare}\n            onToggleCompare={handleToggleCompare}\n            onOpenAdvisorWithProject={handleOpenAdvisorWithProject}\n          />\n        )}\n\n        {activeTab === \"compare\" && (\n          <ComparisonMatrix\n            projects={SWARM_UI_PROJECTS}\n            selectedProjectIds={selectedForCompare}\n            onToggleCompare={handleToggleCompare}\n            onClearCompare={handleClearCompare}\n            onSelectPresets={handleSelectPresets}\n          />\n        )}\n\n        {activeTab === \"simulator\" && (\n          <SwarmSimulator />\n        )}\n\n        {activeTab === \"advisor\" && (\n          <AIResearchAdvisor initialPrompt={advisorInitialPrompt} />\n        )}\n\n        {activeTab === \"recommender\" && (\n          <StackRecommender />\n        )}\n      </main>\n\n      {/* Footer */}\n      <footer className=\"border-t border-slate-900 bg-slate-950 text-slate-500 text-xs py-6\">\n        <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-3\">\n          <div className=\"flex items-center space-x-2\">\n            <Bot className=\"w-4 h-4 text-indigo-400\" />\n            <span>Agent Swarm UI Research Explorer & Architecture Workbench</span>\n          </div>\n          <div className=\"flex items-center space-x-4\">\n            <span>Free & Open Source Multi-Agent Frameworks</span>\n            <span>\342\200\242</span>\n            <span>MIT & Apache-2.0</span>\n          </div>\n        </div>\n      </footer>\n    </div>\n  );\n}\n"
    }
