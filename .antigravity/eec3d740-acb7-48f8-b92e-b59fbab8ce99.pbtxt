    replacement_infos {
      original_chunk {
        target_content: "export default function App() {\n  const [sidebarOpen, setSidebarOpen] = useState(true);\n  const [activeView, setActiveView] = useState<\"chat\" | \"search\" | \"meeting-notes\" | \"routines\" | \"project\">(\"chat\");\n  const [connectors, setConnectors] = useState<AppConnector[]>(INITIAL_CONNECTORS);\n  const [meetingNotes, setMeetingNotes] = useState<MeetingNote[]>(INITIAL_MEETING_NOTES);\n  const [routines, setRoutines] = useState<Routine[]>(INITIAL_ROUTINES);\n  const [projects, setProjects] = useState<ProjectItem[]>(INITIAL_PROJECTS);\n  const [connectorDrawerOpen, setConnectorDrawerOpen] = useState(false);\n  const [selectedConnectorId, setSelectedConnectorId] = useState<string | null>(null);\n  const [searchModalOpen, setSearchModalOpen] = useState(false);\n  const [isLoading, setIsLoading] = useState(false);\n\n  const [user, setUser] = useState<UserProfile>({\n    name: \"gaman sai\",\n    email: \"vijay.goona@gmail.com\",\n    plan: \"Basic\",\n    avatarGradient: \"from-purple-400 via-pink-300 to-cyan-300\",\n    version: \"0.84.17\",\n    contextEnabled: true,\n  });\n\n  // Window tabs matching screenshot\n  const [tabs, setTabs] = useState<ChatTab[]>([\n    {\n      id: \"tab-doc\",\n      title: \"Document and Image U...\",\n      type: \"chat\",\n      messages: [\n        {\n          id: \"m-init-1\",\n          role: \"user\",\n          content: \"Analyze the uploaded agent architecture diagram and summarize key components.\",\n          timestamp: \"Yesterday\",\n        },\n        {\n          id: \"m-init-2\",\n          role: \"assistant\",\n          content: \"The diagram depicts a hierarchical supervisor coordinating specialized researcher, coder, and analyst sub-agents with 2-way context grounding in Google Drive and Linear.\",\n          timestamp: \"Yesterday\",\n          toolsUsed: [\n            { name: \"Google Drive\", icon: \"gdrive\", status: \"completed\" },\n            { name: \"Linear\", icon: \"linear\", status: \"completed\" },\n          ],\n        },\n      ],\n      model: \"Max\",\n      createdAt: \"Yesterday\",\n      connectedAppIds: [\"gdrive\", \"linear\"],\n    },\n    {\n      id: \"tab-tutorial\",\n      title: \"AI Agent Tutorial\",\n      type: \"chat\",\n      messages: [\n        {\n          id: \"m-tut-1\",\n          role: \"user\",\n          content: \"Explain how multi-agent handoffs work in Agency Swarm and AutoGen Studio.\",\n          timestamp: \"Aug 24\",\n        },\n        {\n          id: \"m-tut-2\",\n          role: \"assistant\",\n          content: \"In Agency Swarm, handoffs occur through peer-to-peer agency charts with direct messaging tools. In AutoGen, group chat managers route control dynamically using speaker selection algorithms.\",\n          timestamp: \"Aug 24\",\n        },\n      ],\n      model: \"Gemini 3.7 Flash\",\n      createdAt: \"Aug 24\",\n      connectedAppIds: [\"notion\", \"github\"],\n    },\n    {\n      id: \"tab-active\",\n      title: \"New Chat\",\n      type: \"chat\",\n      messages: [],\n      model: \"Max\",\n      createdAt: \"Today\",\n      connectedAppIds: [\"dropbox\", \"gcalendar\", \"gdrive\", \"asana\", \"linear\", \"notion\", \"slack\", \"discord\", \"zapier\", \"github\"],\n    },\n  ]);\n\n  const [activeTabId, setActiveTabId] = useState<string>(\"tab-active\");\n\n  const currentTab = tabs.find((t) => t.id === activeTabId) || tabs[0];"
        replacement_content: "export default function App() {\n  const [sidebarPinned, setSidebarPinned] = useState(false);\n  const [sidebarHovered, setSidebarHovered] = useState(false);\n  const [activeView, setActiveView] = useState<\"chat\" | \"search\" | \"meeting-notes\" | \"routines\" | \"project\">(\"chat\");\n  const [connectors, setConnectors] = useState<AppConnector[]>(INITIAL_CONNECTORS);\n  const [meetingNotes, setMeetingNotes] = useState<MeetingNote[]>(INITIAL_MEETING_NOTES);\n  const [routines, setRoutines] = useState<Routine[]>(INITIAL_ROUTINES);\n  const [projects, setProjects] = useState<ProjectItem[]>(INITIAL_PROJECTS);\n  const [connectorDrawerOpen, setConnectorDrawerOpen] = useState(false);\n  const [selectedConnectorId, setSelectedConnectorId] = useState<string | null>(null);\n  const [searchModalOpen, setSearchModalOpen] = useState(false);\n  const [isLoading, setIsLoading] = useState(false);\n\n  const [user, setUser] = useState<UserProfile>({\n    name: \"Gaman\",\n    email: \"vijay.goona@gmail.com\",\n    plan: \"Basic\",\n    avatarGradient: \"from-purple-400 via-pink-300 to-cyan-300\",\n    version: \"0.84.17\",\n    contextEnabled: true,\n  });\n\n  // Real fresh chat session without fake placeholder chats\n  const [tabs, setTabs] = useState<ChatTab[]>([\n    {\n      id: \"tab-real-1\",\n      title: \"New Chat\",\n      type: \"chat\",\n      messages: [],\n      model: \"Max\",\n      createdAt: \"Today\",\n      connectedAppIds: [\"dropbox\", \"gcalendar\", \"gdrive\", \"asana\", \"linear\", \"notion\", \"slack\", \"discord\", \"zapier\", \"github\"],\n    },\n  ]);\n\n  const [activeTabId, setActiveTabId] = useState<string>(\"tab-real-1\");\n\n  const currentTab = tabs.find((t) => t.id === activeTabId) || tabs[0];\n\n  const isSidebarVisible = sidebarPinned || sidebarHovered;"
      }
