  file_change {
    absolute_path_uri: "file:///src/components/ConnectorDrawer.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \"react\";\nimport { \n  X, \n  CheckCircle2, \n  RotateCw, \n  ExternalLink, \n  Search, \n  ShieldCheck, \n  Key, \n  Link2, \n  Plus, \n  Trash2, \n  Sparkles,\n  Layers,\n  ArrowRight\n} from \"lucide-react\";\nimport { AppIconRenderer } from \"./ConnectorIcons\";\nimport { AppConnector } from \"../types\";\n\ninterface ConnectorDrawerProps {\n  isOpen: boolean;\n  onClose: () => void;\n  connectors: AppConnector[];\n  onConnect: (id: string, account?: string, credentials?: any) => Promise<void>;\n  onSync: (id: string) => Promise<void>;\n  onDisconnect: (id: string) => Promise<void>;\n  selectedConnectorId?: string | null;\n}\n\nexport const ConnectorDrawer: React.FC<ConnectorDrawerProps> = ({\n  isOpen,\n  onClose,\n  connectors,\n  onConnect,\n  onSync,\n  onDisconnect,\n  selectedConnectorId = null,\n}) => {\n  const [activeId, setActiveId] = useState<string>(selectedConnectorId || connectors[0]?.id || \"dropbox\");\n  const [searchQuery, setSearchQuery] = useState(\"\");\n  const [syncingId, setSyncingId] = useState<string | null>(null);\n  const [customCreds, setCustomCreds] = useState<Record<string, string>>({});\n  const [toastMessage, setToastMessage] = useState<string | null>(null);\n\n  if (!isOpen) return null;\n\n  const currentConnector = connectors.find((c) => c.id === activeId) || connectors[0];\n\n  const handleSync = async (id: string) => {\n    setSyncingId(id);\n    await onSync(id);\n    setSyncingId(null);\n    showToast(`Synchronized ${currentConnector.name} data items successfully.`);\n  };\n\n  const handleConnect = async (id: string) => {\n    await onConnect(id, undefined, customCreds);\n    showToast(`Connected ${currentConnector.name} to your Littlebird workspace.`);\n  };\n\n  const handleDisconnect = async (id: string) => {\n    await onDisconnect(id);\n    showToast(`Disconnected ${currentConnector.name}.`);\n  };\n\n  const showToast = (msg: string) => {\n    setToastMessage(msg);\n    setTimeout(() => setToastMessage(null), 3000);\n  };\n\n  const filteredItems = currentConnector.dataItems.filter(\n    (item) =>\n      item.title.toLowerCase().includes(searchQuery.toLowerCase()) ||\n      (item.summary && item.summary.toLowerCase().includes(searchQuery.toLowerCase()))\n  );\n\n  return (\n    <div className=\"fixed inset-0 z-50 bg-stone-900/40 backdrop-blur-xs flex items-center justify-center p-4 sm:p-6 animate-fadeIn\">\n      <div className=\"bg-[#faf8f5] border border-[#ded7c8] rounded-2xl w-full max-w-4xl h-[620px] shadow-2xl flex flex-col overflow-hidden\">\n        {/* Header */}\n        <div className=\"h-14 border-b border-[#e8e3d8] px-5 flex items-center justify-between bg-[#f5f1e8]\">\n          <div className=\"flex items-center space-x-2.5\">\n            <div className=\"w-8 h-8 rounded-lg bg-white border border-[#ded7c8] flex items-center justify-center shadow-xs\">\n              <AppIconRenderer iconName={currentConnector.icon} className=\"w-5 h-5\" />\n            </div>\n            <div>\n              <h3 className=\"text-sm font-bold text-stone-900 flex items-center space-x-2\">\n                <span>App Connectors & Enterprise Grounding</span>\n                <span className=\"text-[10px] bg-emerald-100 text-emerald-800 font-semibold px-2 py-0.5 rounded-full border border-emerald-300\">\n                  Live Grounding\n                </span>\n              </h3>\n              <p className=\"text-[11px] text-stone-500\">\n                Manage accounts, grant permissions, and inspect real synchronized data items.\n              </p>\n            </div>\n          </div>\n\n          <button\n            id=\"close-connectors-drawer-btn\"\n            onClick={onClose}\n            className=\"p-1.5 text-stone-400 hover:text-stone-700 hover:bg-[#eae4d7] rounded-lg transition-colors\"\n          >\n            <X className=\"w-5 h-5\" />\n          </button>\n        </div>\n\n        {/* Body Split View */}\n        <div className=\"flex-1 flex overflow-hidden\">\n          {/* Left App List Column */}\n          <div className=\"w-64 border-r border-[#e8e3d8] bg-[#f7f4ec] p-3 overflow-y-auto space-y-1\">\n            <div className=\"px-2 py-1 text-[11px] font-bold text-stone-500 uppercase tracking-wider\">\n              Connected Apps ({connectors.filter((c) => c.status === \"connected\").length}/{connectors.length})\n            </div>\n\n            {connectors.map((connector) => {\n              const isSelected = connector.id === currentConnector.id;\n              const isConnected = connector.status === \"connected\";\n\n              return (\n                <button\n                  key={connector.id}\n                  onClick={() => {\n                    setActiveId(connector.id);\n                    setSearchQuery(\"\");\n                  }}\n                  className={`w-full flex items-center justify-between px-3 py-2 rounded-xl text-xs font-medium transition-all ${\n                    isSelected\n                      ? \"bg-white text-stone-900 font-semibold shadow-xs border border-[#ded7c8]\"\n                      : \"text-stone-700 hover:bg-[#eee8dc] border border-transparent\"\n                  }`}\n                >\n                  <div className=\"flex items-center space-x-2.5 min-w-0\">\n                    <AppIconRenderer iconName={connector.icon} className=\"w-4 h-4 shrink-0\" />\n                    <span className=\"truncate\">{connector.name}</span>\n                  </div>\n\n                  <span\n                    className={`w-2 h-2 rounded-full shrink-0 ${\n                      isConnected ? \"bg-emerald-500\" : \"bg-stone-300\"\n                    }`}\n                  ></span>\n                </button>\n              );\n            })}\n          </div>\n\n          {/* Right Details & Synchronized Data Column */}\n          <div className=\"flex-1 flex flex-col bg-[#faf8f5] p-5 overflow-y-auto space-y-4\">\n            {/* Connector Status Banner */}\n            <div className=\"bg-white border border-[#ded7c8] rounded-xl p-4 flex flex-col sm:flex-row sm:items-center justify-between gap-3 shadow-xs\">\n              <div className=\"flex items-center space-x-3\">\n                <div className=\"w-10 h-10 rounded-xl bg-[#f7f4ec] border border-[#ded7c8] flex items-center justify-center\">\n                  <AppIconRenderer iconName={currentConnector.icon} className=\"w-6 h-6\" />\n                </div>\n                <div>\n                  <div className=\"flex items-center space-x-2\">\n                    <h4 className=\"text-sm font-bold text-stone-900\">{currentConnector.name}</h4>\n                    <span\n                      className={`text-[10px] font-bold px-2 py-0.5 rounded-full uppercase ${\n                        currentConnector.status === \"connected\"\n                          ? \"bg-emerald-50 text-emerald-700 border border-emerald-200\"\n                          : \"bg-stone-100 text-stone-600 border border-stone-200\"\n                      }`}\n                    >\n                      {currentConnector.status}\n                    </span>\n                  </div>\n                  <p className=\"text-xs text-stone-500 mt-0.5\">{currentConnector.description}</p>\n                </div>\n              </div>\n\n              {/* Action Buttons */}\n              <div className=\"flex items-center space-x-2 shrink-0\">\n                {currentConnector.status === \"connected\" ? (\n                  <>\n                    <button\n                      onClick={() => handleSync(currentConnector.id)}\n                      disabled={syncingId === currentConnector.id}\n                      className=\"px-3 py-1.5 bg-[#f0ebd9] hover:bg-[#e6dfcb] text-stone-800 rounded-lg text-xs font-semibold flex items-center space-x-1.5 transition-colors cursor-pointer\"\n                    >\n                      <RotateCw\n                        className={`w-3.5 h-3.5 ${\n                          syncingId === currentConnector.id ? \"animate-spin\" : \"\"\n                        }`}\n                      />\n                      <span>{syncingId === currentConnector.id ? \"Syncing...\" : \"Sync Now\"}</span>\n                    </button>\n                    <button\n                      onClick={() => handleDisconnect(currentConnector.id)}\n                      className=\"px-3 py-1.5 bg-stone-100 hover:bg-rose-50 text-rose-700 hover:text-rose-800 rounded-lg text-xs font-medium transition-colors cursor-pointer\"\n                    >\n                      Disconnect\n                    </button>\n                  </>\n                ) : (\n                  <button\n                    onClick={() => handleConnect(currentConnector.id)}\n                    className=\"px-4 py-1.5 bg-stone-900 hover:bg-stone-800 text-white rounded-lg text-xs font-semibold flex items-center space-x-1.5 transition-colors cursor-pointer shadow-xs\"\n                  >\n                    <Link2 className=\"w-3.5 h-3.5\" />\n                    <span>Connect {currentConnector.name}</span>\n                  </button>\n                )}\n              </div>\n            </div>\n\n            {/* Account & Sync Metadata Bar */}\n            {currentConnector.status === \"connected\" && (\n              <div className=\"grid grid-cols-3 gap-2 text-xs\">\n                <div className=\"bg-[#f5f1e8] p-2.5 rounded-lg border border-[#e8e3d8]\">\n                  <span className=\"text-stone-500 text-[10px] block font-medium\">Connected Account</span>\n                  <span className=\"font-semibold text-stone-800 truncate block\">\n                    {currentConnector.connectedAccount || \"Personal Workspace\"}\n                  </span>\n                </div>\n                <div className=\"bg-[#f5f1e8] p-2.5 rounded-lg border border-[#e8e3d8]\">\n                  <span className=\"text-stone-500 text-[10px] block font-medium\">Last Synced</span>\n                  <span className=\"font-semibold text-stone-800 block\">\n                    {currentConnector.lastSynced || \"Just now\"}\n                  </span>\n                </div>\n                <div className=\"bg-[#f5f1e8] p-2.5 rounded-lg border border-[#e8e3d8]\">\n                  <span className=\"text-stone-500 text-[10px] block font-medium\">Items Grounded</span>\n                  <span className=\"font-semibold text-stone-800 block\">\n                    {currentConnector.itemCount} items ready for prompt\n                  </span>\n                </div>\n              </div>\n            )}\n\n            {/* Synchronized Data Items Browser */}\n            <div className=\"flex-1 flex flex-col space-y-2\">\n              <div className=\"flex items-center justify-between\">\n                <span className=\"text-xs font-bold text-stone-700\">\n                  Synchronized Knowledge & Assets ({currentConnector.dataItems.length})\n                </span>\n\n                <div className=\"relative w-48\">\n                  <Search className=\"w-3.5 h-3.5 absolute left-2.5 top-2 text-stone-400\" />\n                  <input\n                    type=\"text\"\n                    value={searchQuery}\n                    onChange={(e) => setSearchQuery(e.target.value)}\n                    placeholder=\"Filter items...\"\n                    className=\"w-full pl-8 pr-2 py-1 bg-white border border-[#ded7c8] rounded-lg text-xs text-stone-800 placeholder-stone-400 focus:outline-none focus:border-stone-500\"\n                  />\n                </div>\n              </div>\n\n              <div className=\"flex-1 space-y-2 overflow-y-auto max-h-56 pr-1\">\n                {filteredItems.length === 0 ? (\n                  <div className=\"p-6 bg-white border border-[#ded7c8] rounded-xl text-center text-xs text-stone-500\">\n                    No items match your filter.\n                  </div>\n                ) : (\n                  filteredItems.map((item) => (\n                    <div\n                      key={item.id}\n                      className=\"p-3 bg-white border border-[#ded7c8] hover:border-stone-400 rounded-xl space-y-1 transition-all shadow-2xs\"\n                    >\n                      <div className=\"flex items-center justify-between\">\n                        <span className=\"text-xs font-bold text-stone-900\">{item.title}</span>\n                        <span className=\"text-[10px] text-stone-500\">{item.updatedAt}</span>\n                      </div>\n                      <span className=\"text-[10px] font-mono text-stone-500 bg-[#f7f4ec] px-1.5 py-0.5 rounded border border-[#e8e3d8]\">\n                        {item.type}\n                      </span>\n                      {item.summary && (\n                        <p className=\"text-[11px] text-stone-600 leading-relaxed pt-0.5\">\n                          {item.summary}\n                        </p>\n                      )}\n                    </div>\n                  ))\n                )}\n              </div>\n            </div>\n\n            {/* Custom Credentials Configuration Drawer */}\n            <div className=\"bg-[#f5f1e8] border border-[#e8e3d8] rounded-xl p-3.5 space-y-2\">\n              <div className=\"flex items-center space-x-1.5 text-xs font-bold text-stone-800\">\n                <Key className=\"w-3.5 h-3.5 text-amber-600\" />\n                <span>API Credentials & OAuth Keys (Optional Override)</span>\n              </div>\n              <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-2\">\n                {currentConnector.authFields.map((field) => (\n                  <div key={field.key}>\n                    <label className=\"text-[10px] text-stone-500 font-medium block mb-0.5\">\n                      {field.label}\n                    </label>\n                    <input\n                      type={field.type === \"password\" ? \"password\" : \"text\"}\n                      placeholder={field.placeholder}\n                      value={customCreds[field.key] || \"\"}\n                      onChange={(e) =>\n                        setCustomCreds({ ...customCreds, [field.key]: e.target.value })\n                      }\n                      className=\"w-full px-2.5 py-1.5 bg-white border border-[#ded7c8] rounded-lg text-xs text-stone-800 focus:outline-none focus:border-stone-600 font-mono\"\n                    />\n                  </div>\n                ))}\n              </div>\n            </div>\n          </div>\n        </div>\n\n        {/* Toast Notification */}\n        {toastMessage && (\n          <div className=\"absolute bottom-4 right-4 bg-stone-900 text-white text-xs px-3.5 py-2 rounded-xl shadow-lg flex items-center space-x-2 animate-bounce\">\n            <CheckCircle2 className=\"w-4 h-4 text-emerald-400\" />\n            <span>{toastMessage}</span>\n          </div>\n        )}\n      </div>\n    </div>\n  );\n};\n"
    }
