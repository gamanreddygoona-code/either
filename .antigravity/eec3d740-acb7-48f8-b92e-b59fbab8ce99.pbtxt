aItems: [\n      {\n        id: \"cal-1\",\n        title: \"AI Agent Swarm Architecture Sync\",\n        type: \"Calendar Event\",\n        updatedAt: \"Today, 4:00 PM - 4:45 PM\",\n        summary: \"Discussing real connector integration and multi-agent latency benchmarks with team.\",\n      },\n      {\n        id: \"cal-2\",\n        title: \"Weekly Product Strategy Review\",\n        type: \"Calendar Event\",\n        updatedAt: \"Tomorrow, 10:00 AM - 11:00 AM\",\n        summary: \"Reviewing Q3 sprint deliverables, user feedback, and Littlebird design polish.\",\n      },\n      {\n        id: \"cal-3\",\n        title: \"1-on-1 with Engineering Lead\",\n        type: \"Calendar Event\",\n        updatedAt: \"Friday, 2:30 PM\",\n        summary: \"Bi-weekly sync on full-stack architecture, Gemini grounding, and container deploy.\",\n      },\n    ],\n    authFields: [\n      { key: \"googleOAuth\", label: \"Connect with Google\", placeholder: \"Authorize Google Calendar\", type: \"oauth\" },\n    ],\n  },\n  {\n    id: \"gdrive\",\n    name: \"Google Drive\",\n    category: \"storage\",\n    icon: \"drive\",\n    brandColor: \"#0F9D58\",\n    description: \"Search Google Docs, Sheets, and Slides to ground AI reasoning in your company knowledge.\",\n    status: \"connected\",\n    connectedAccount: \"vijay.goona@gmail.com\",\n    lastSynced: \"5 mins ago\",\n    itemCount: 128,\n    dataItems: [\n      {\n        id: \"gdrv-1\",\n        title: \"Product Requirement Doc: Real App Connectors\",\n        type: \"Google Doc\",\n        updatedAt: \"Today, 1:40 PM\",\n        summary: \"Specifying two-way sync, OAuth token caching, and context injection into prompts.\",\n      },\n      {\n        id: \"gdrv-2\",\n        title: \"Q3 Engineering Sprints & OKR Tracking\",\n        type: \"Google Sheet\",\n        updatedAt: \"Today, 11:20 AM\",\n        summary: \"Sprint 14 backlog, bug burn-down rate, and Gemini 3.7 Flash latency metrics.\",\n      },\n      {\n        id: \"gdrv-3\",\n        title: \"Autonomous Agent Architecture Diagram 2026\",\n        type: \"Google Slides\",\n        updatedAt: \"Yesterday\",\n        summary: \"Hierarchical supervisor, peer handoffs, and tool execution security boundary.\",\n      },\n    ],\n    authFields: [\n      { key: \"googleOAuth\", label: \"Google Drive OAuth\", placeholder: \"Authorize Google Drive\", type: \"oauth\" },\n    ],\n  },\n  {\n    id: \"asana\",\n    name: \"Asana\",\n    category: \"productivity\",\n    icon: \"asana\",\n    brandColor: \"#F06A6A\",\n    description: \"Access projects, milestones, task assignees, and sprint deliverables.\",\n    status: \"connected\",\n    connectedAccount: \"Vijay Goona (Workspace: Littlebird Core)\",\n    lastSynced: \"12 mins ago\",\n    itemCount: 34,\n    dataItems: [\n      {\n        id: \"asn-1\",\n        title: \"Complete Real Connector Multi-tool Grounding\",\n        type: \"Asana Task\",\n        updatedAt: \"Due Tomorrow\",\n        summary: \"Assignee: Vijay Goona | Priority: High | Status: In Progress\",\n      },\n      {\n        id: \"asn-2\",\n        title: \"Refactor Prompt Bar Micro-interactions & Dropdowns\",\n        type: \"Asana Task\",\n        updatedAt: \"Due Friday\",\n        summary: \"Assignee: Design Team | Priority: Medium | Status: Review\",\n      },\n      {\n        id: \"asn-3\",\n        title: \"Prepare Release 0.84.17 Production Deployment\",\n        type: \"Asana Task\",\n        updatedAt: \"Due Aug 30\",\n        summary: \"Assignee: DevOps | Priority: High | Status: Planned\",\n      },\n    ],\n    authFields: [\n      { key: \"personalAccessToken\", label: \"Personal Access Token\", placeholder: \"1/120...\", type: \"password\" },\n      { key: \"workspaceId\", label: \"Workspace ID\", placeholder: \"1204859382\", type: \"text\" },\n    ],\n  },\n  {\n    id: \"linear\",\n    name: \"Linear\",\n    category: \"productivity\",\n    icon: \"linear\",\n    brandColor: \"#5E6AD2\",