    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \"react\";\nimport { Search, X, ExternalLink, FileText, Calendar, MessageSquare, CheckCircle2, ArrowRight } from \"lucide-react\";\nimport { AppIconRenderer } from \"./ConnectorIcons\";\n\ninterface SearchModalProps {\n  isOpen: boolean;\n  onClose: () => void;\n  onSelectResult: (query: string) => void;\n}\n\nexport const SearchModal: React.FC<SearchModalProps> = ({\n  isOpen,\n  onClose,\n  onSelectResult,\n}) => {\n  const [searchTerm, setSearchTerm] = useState(\"\");\n\n  if (!isOpen) return null;\n\n  const results = [\n    { title: \"PRD: Real App Connectors & Token Storage\", source: \"gdrive\", type: \"Google Doc\", date: \"Today\", snippet: \"Two-way context injection for Slack, Notion, Drive, Linear, and Dropbox.\" },\n    { title: \"AI Agent Swarm Architecture Sync\", source: \"gcalendar\", type: \"Google Calendar\", date: \"Today, 4:00 PM\", snippet: \"Discussing real connector integration and multi-agent latency benchmarks.\" },\n    { title: \"LB-104: Multi-tab window bar navigation\", source: \"linear\", type: \"Linear Issue\", date: \"Today\", snippet: \"Enable switching between multiple open chats, meeting notes, and routines.\" },\n    { title: \"Autonomous Agent Safety & Privacy Policy\", source: \"notion\", type: \"Notion Wiki\", date: \"Aug 25\", snippet: \"Data retention rules, zero-storage agreements, and sandboxing instructions.\" },\n    { title: \"#general: Version 0.84.17 desktop release announcement\", source: \"slack\", type: \"Slack Thread\", date: \"Aug 26\", snippet: \"Discussion on context engine improvements and connector icon strip.\" },\n    { title: \"Q3 Strategy & Autonomous Agent Roadmap.pdf\", source: \"dropbox\", type: \"Dropbox File\", date: \"Aug 22\", snippet: \"Milestone timeline and quarterly budget breakdown.\" },\n    { title: \"PR #42: Add Littlebird Warm Theme & App Connectors\", source: \"github\", type: \"GitHub PR\", date: \"Today\", snippet: \"Implements genuine connector drawers, multi-tab window bar, and voice speech engine.\" },\n  ];\n\n  const filtered = searchTerm\n    ? results.filter(\n        (r) =>\n          r.title.toLowerCase().includes(searchTerm.toLowerCase()) ||\n          r.snippet.toLowerCase().includes(searchTerm.toLowerCase())\n      )\n    : results;\n\n  return (\n    <div className=\"fixed inset-0 z-50 bg-stone-900/40 backdrop-blur-xs flex items-center justify-center p-4 animate-fadeIn\">\n      <div className=\"bg-[#faf8f5] border border-[#ded7c8] rounded-2xl w-full max-w-2xl shadow-2xl overflow-hidden flex flex-col max-h-[550px]\">\n        {/* Search Input Bar */}\n        <div className=\"p-4 border-b border-[#e8e3d8] flex items-center space-x-3 bg-white\">\n          <Search className=\"w-5 h-5 text-stone-400 shrink-0\" />\n          <input\n            type=\"text\"\n            value={searchTerm}\n            onChange={(e) => setSearchTerm(e.target.value)}\n            placeholder=\"Search across Google Drive, Notion, Slack, Linear, Calendar...\"\n            autoFocus\n            className=\"w-full bg-transparent text-sm text-stone-900 placeholder-stone-400 focus:outline-none\"\n          />\n          <button\n            onClick={onClose}\n            className=\"p-1 text-stone-400 hover:text-stone-700 rounded-lg\"\n          >\n            <X className=\"w-4 h-4\" />\n          </button>\n        </div>\n\n        {/* Results List */}\n        <div className=\"flex-1 overflow-y-auto p-4 space-y-2\">\n          <div className=\"text-[11px] font-bold text-stone-500 uppercase tracking-wider px-2\">\n            Connected Knowledge Grounding ({filtered.length})\n          </div>\n\n          {filtered.length === 0 ? (\n            <div className=\"text-center py-10 text-xs text-stone-500\">\n              No results found for \"{searchTerm}\".\n            </div>\n          ) : (\n            filtered.map((item, idx) => (\n              <div\n                key={idx}\n                onClick={() => {\n                  onSelectResult(`Search result: \"${item.title}\" - ${item.snippet}`);\n                  onClose();\n                }}\n                className=\"p-3 bg-white hover:bg-[#f7f4ec] border border-[#ded7c8] hover:border-stone-400 rounded-xl cursor-pointer transition-all shadow-2xs space-y-1 group\"\n              >\n                <div className=\"flex items-center justify-between\">\n                  <div className=\"flex items-center space-x-2\">\n                    <AppIconRenderer iconName={item.source} className=\"w-4 h-4\" />\n                    <span className=\"text-xs font-bold text-stone-900 group-hover:text-stone-950\">\n                      {item.title}\n                    </span>\n                  </div>\n                  <span className=\"text-[10px] text-stone-400\">{item.date}</span>\n                </div>\n                <p className=\"text-[11px] text-stone-600 pl-6 leading-relaxed\">\n                  {item.snippet}\n                </p>\n              </div>\n            ))\n          )}\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    }
