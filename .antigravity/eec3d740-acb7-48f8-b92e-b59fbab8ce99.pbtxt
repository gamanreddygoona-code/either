  file_change {
    absolute_path_uri: "file:///server.ts"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import express from \"express\";\nimport path from \"path\";\nimport { createServer as createViteServer } from \"vite\";\nimport { GoogleGenAI } from \"@google/genai\";\nimport dotenv from \"dotenv\";\n\ndotenv.config();\n\nconst app = express();\nconst PORT = 3000;\n\napp.use(express.json());\n\n// Initialize Gemini API client\nlet aiClient: GoogleGenAI | null = null;\nfunction getAI(): GoogleGenAI | null {\n  if (!aiClient && process.env.GEMINI_API_KEY) {\n    aiClient = new GoogleGenAI({\n      apiKey: process.env.GEMINI_API_KEY,\n      httpOptions: {\n        headers: {\n          \"User-Agent\": \"aistudio-build\",\n        },\n      },\n    });\n  }\n  return aiClient;\n}\n\n// In-memory data store for connectors and items\nlet connectorsState: Record<string, any> = {\n  dropbox: { status: \"connected\", connectedAccount: \"gaman.sai@littlebird.internal\", lastSynced: \"Just now\", itemCount: 42 },\n  gcalendar: { status: \"connected\", connectedAccount: \"vijay.goona@gmail.com\", lastSynced: \"2 mins ago\", itemCount: 8 },\n  gdrive: { status: \"connected\", connectedAccount: \"vijay.goona@gmail.com\", lastSynced: \"5 mins ago\", itemCount: 128 },\n  asana: { status: \"connected\", connectedAccount: \"Asana Workspace: Littlebird Core\", lastSynced: \"12 mins ago\", itemCount: 34 },\n  linear: { status: \"connected\", connectedAccount: \"team-littlebird.linear.app\", lastSynced: \"3 mins ago\", itemCount: 19 },\n  notion: { status: \"connected\", connectedAccount: \"Littlebird Knowledge Base\", lastSynced: \"10 mins ago\", itemCount: 56 },\n  slack: { status: \"connected\", connectedAccount: \"Workspace: #littlebird-dev\", lastSynced: \"1 min ago\", itemCount: 92 },\n  discord: { status: \"connected\", connectedAccount: \"Server: Littlebird AI Community\", lastSynced: \"8 mins ago\", itemCount: 15 },\n  zapier: { status: \"connected\", connectedAccount: \"Zapier Account: Gaman Sai (Pro)\", lastSynced: \"15 mins ago\", itemCount: 6 },\n  github: { status: \"connected\", connectedAccount: \"vijay.goona@gmail.com\", lastSynced: \"4 mins ago\", itemCount: 14 },\n};\n\n// Health check endpoint\napp.get(\"/api/health\", (_req, res) => {\n  res.json({\n    status: \"ok\",\n    app: \"Littlebird Workspace\",\n    hasApiKey: Boolean(process.env.GEMINI_API_KEY),\n    timestamp: new Date().toISOString(),\n  });\n});\n\n// Connectors endpoints\napp.get(\"/api/connectors\", (_req, res) => {\n  res.json({ connectors: connectorsState });\n});\n\napp.post(\"/api/connectors/:id/connect\", (req, res) => {\n  const { id } = req.params;\n  const { account, credentials } = req.body;\n  connectorsState[id] = {\n    status: \"connected\",\n    connectedAccount: account || `${id}-account@littlebird.internal`,\n    lastSynced: \"Just now\",\n    itemCount: Math.floor(Math.random() * 50) + 10,\n    credentialsConfigured: Boolean(credentials),\n  };\n  res.json({ success: true, connector: connectorsState[id] });\n});\n\napp.post(\"/api/connectors/:id/sync\", (req, res) => {\n  const { id } = req.params;\n  if (connectorsState[id]) {\n    connectorsState[id].lastSynced = \"Just now\";\n    connectorsState[id].itemCount += Math.floor(Math.random() * 3) + 1;\n  }\n  res.json({ success: true, connector: connectorsState[id] });\n});\n\napp.post(\"/api/connectors/:id/disconnect\", (req, res) => {\n  const { id } = req.params;\n  connectorsState[id] = {\n    status: \"disconnected\",\n    connectedAccount: undefined,\n    lastSynced: undefined,\n    itemCount: 0,\n  };\n  res.json({ success: true, connector: connectorsState[id] });\n});\n\n// Main Chat Endpoint with Gemini 3.7 Flash, Google Search Grounding & Connected App Context\napp.post(\"/api/chat\", async (req, res) => {\n  const { prompt, history, model = \"Max\", activeConnectors = [], connectedContext = \"\" } = req.body;\n\n  if (!prompt || typeof prompt !== \"string\") {\n    return res.status(400).json({ error: \"Prompt is required\" });\n  }\n\n  const ai = getAI();\n\n  // Simulated tool operations detected based on query\n  const toolsUsed: any[] = [];\n  const queryLower = prompt.toLowerCase();\n\n  if (queryLower.includes(\"calendar\") || queryLower.includes(\"meeting\") || queryLower.includes(\"schedule\")) {\n    toolsUsed.push({\n      name: \"Google Calendar Sync\",\n      icon: \"calendar\",\n      status: \"completed\",\n      details: \"Retrieved 3 events for Wednesday, August 26 (AI Architecture Sync, Strategy Review)\",\n    });\n  }\n  if (queryLower.includes(\"drive\") || queryLower.includes(\"doc\") || queryLower.includes(\"spec\") || queryLower.includes(\"roadmap\")) {\n    toolsUsed.push({\n      name: \"Google Drive Knowledge Base\",\n      icon: \"drive\",\n      status: \"completed\",\n      details: \"Read \'PRD: Real App Connectors\' & \'Q3 Strategy Roadmap.pdf\'\",\n    });\n  }\n  if (queryLower.includes(\"linear\") || queryLower.includes(\"issue\") || queryLower.includes(\"bug\") || queryLower.includes(\"ticket\")) {\n    toolsUsed.push({\n      name: \"Linear Issue Tracker\",\n      icon: \"linear\",\n      status: \"completed\",\n      details: \"Scanned Cycle 24 issues: LB-104 (Multi-tab bar), LB-98 (Voice mic)\",\n    });\n  }\n  if (queryLower.includes(\"notion\") || queryLower.includes(\"wiki\") || queryLower.includes(\"policy\") || queryLower.includes(\"data protect\")) {\n    toolsUsed.push({\n      name: \"Notion Enterprise Wiki\",\n      icon: \"notion\",\n      status: \"completed\",\n      details: \"Verified \'Autonomous Agent Safety & Privacy Policy\' (Zero data retention)\",\n    });\n  }\n  if (queryLower.includes(\"slack\") || queryLower.includes(\"message\") || queryLower.includes(\"thread\") || queryLower.includes(\"chat\")) {\n    toolsUsed.push({\n      name: \"Slack Channel Feed\",\n      icon: \"slack\",\n      status: \"completed\",\n      details: \"Parsed recent discussions in #general and #eng-agents\",\n    });\n  }\n  if (queryLower.includes(\"github\") || queryLower.includes(\"code\") || queryLower.includes(\"pr\") || queryLower.includes(\"repo\")) {\n    toolsUsed.push({\n      name: \"GitHub Repository Inspection\",\n      icon: \"github\",\n      status: \"completed\",\n      details: \"Checked PR #42 (Littlebird Warm Minimalist Theme) & commit diffs\",\n    });\n  }\n\n  // Fallback offline responses if API key is not yet set\n  if (!ai) {\n    let answer = \"\";\n    if (queryLower.includes(\"data protect\") || queryLower.includes(\"privacy\")) {\n      answer = `### How Your Data is Protected in Littlebird\n\nYour privacy and security are architected as first-class primitives in Littlebird:\n\n1. **Zero-Trust App Connections**:\n   - Authentication tokens for **Google Drive**, **Notion**, **Linear**, **Slack**, and **Dropbox** are encrypted with AES-256 and only accessed during active tool invocation.\n   - We do **not** train general foundation models on your proprietary connected docs or chat history.\n\n2. **Isolated Tool Sandboxing**:\n   - Each connector query runs in an ephemeral sandboxed process with least-privilege scoping.\n   - You can disconnect or revoke permissions for any connector at any time with a single click.\n\n3. **Client-Side Context Control**:\n   - You can toggle the **\"\342\227\217 Context enabled\"** setting in the sidebar at any time to prevent local session state from attaching to prompt requests.\n\n*(To enable live Gemini 3.7 Flash inference, set \\`GEMINI_API_KEY\\` in your environment).*`;\n    } else if (queryLower.includes(\"capabilities\") || queryLower.includes(\"what can you do\")) {\n      answer = `### Littlebird Core Capabilities\n\nLittlebird is your unified AI agent workspace and executive intelligence engine:\n\n- **Connected Knowledge Grounding**: Live 2-way sync with **Google Drive**, **Dropbox**, **Notion**, **Asana**, **Linear**, **Slack**, **Discord**, **Zapier**, and **GitHub**.\n- **Real-Time Calendar & Meeting Assistant**: Automatically transcribes meetings, summarizes key decisions, and creates actionable tickets.\n- **Autonomous Routines**: Runs scheduled agent workflows (e.g. morning briefing digests, PR review summaries, daily triage).\n- **Multi-Tab Workspace**: Keep multiple active conversations, project folders, and meeting notes open concurrently.\n- **Voice Speech Input**: Dictate prompts directly using native browser speech recognition.`;\n    } else if (queryLower.includes(\"declutter\")) {\n      answer = `### Popular Decluttering Methods & Frameworks\n\nHere are the most effective, research-backed decluttering systems for physical and digital workspaces:\n\n1. **The KonMari Method (Marie Kondo)**\n   - *Core Rule*: Category-by-category rather than room-by-room (Clothes \342\206\222 Books \342\206\222 Papers \342\206\222 Komono/Misc \342\206\222 Sentimental).\n   - *Guiding Question*: \"Does this spark joy?\" Keep only items that serve a positive purpose.\n\n2. **The Four-Box Method**\n   - Place 4 bins in every room: **Keep**, **Donate/Sell**, **Trash/Recycle**, and **Relocate**.\n   - Pick up every item once and assign it immediately without hesitation.\n\n3. **The 20/20 Rule (The Minimalists)**\n   - If you can replace an item for less than $20 in less than 20 minutes from where you are, you can safely let it go.\n\n4. **The Swedish Death Cleaning (D\303\266st\303\244dning)**\n   - Focuses on freeing future generations from sorting your belongings, emphasizing intentional legacy and practical utility.\n\n5. **Digital Decluttering for Knowledge Workers**:\n   - Group active browser tabs into Littlebird workspaces.\n   - Archive Slack channels inactive for >30 days.\n   - Clear desktop downloads into structured Project Folders (like your \\`ai\\` folder).`;\n    } else {\n      answer = `### Littlebird Assistant\n\nI have processed your request: **\"${prompt}\"**.\n\n${toolsUsed.length > 0 ? `**Synchronized Connected Apps:**\\n` + toolsUsed.map(t => `- **${t.name}**: ${t.details}`).join(\'\\n\') + \'\\n\\n\' : \'\'}\nHere are the next steps to proceed:\n1. Grounded against your active workspace projects and connected apps.\n2. You can ask follow-ups, trigger automated routines, or attach more context with the **+** button.\n\n*(Note: Add your \\`GEMINI_API_KEY\\` in Settings to enable live Google Search grounding and full generative reasoning).*`;\n    }\n\n    return res.json({\n      answer,\n      toolsUsed,\n      sources: [\n        { title: \"Littlebird Knowledge Base\", uri: \"https://littlebird.internal/docs\" },\n        { title: \"Connected Google Drive & Notion Context\", uri: \"https://drive.google.com\" },\n      ],\n    });\n  }\n\n  try {\n    const systemPrompt = `You are Littlebird, a calm, deeply intelligent, and extraordinarily capable AI workspace assistant and multi-agent orchestrator.\nUser Name: gaman sai (vijay.goona@gmail.com).\nCurrent Date: Wednesday, August 26, 2026.\n\nYou have direct access to connected enterprise tools:\n- Dropbox (cloud files and specs)\n- Google Calendar (meetings and schedule)\n- Google Drive (Docs, Sheets, Slides)\n- Asana (tasks and milestones)\n- Linear (engineering tickets, issues LB-104, LB-98)\n- Notion (internal wikis, privacy policies)\n- Slack (#general, #eng-agents)\n- Discord (developer community)\n- Zapier (automations)\n- GitHub (code, PR #42, commits)\n\n${connectedContext ? `Active Context from Connected Tools:\\n${connectedContext}\\n` : \"\"}\n\nGuidelines:\n- Tone: Thoughtful, executive, articulate, structured, and clear.\n- Use clean Markdown formatting with clear headings, bullet points, and code blocks where helpful.\n- When the user asks about meetings, tasks, files, code, or routines, reference their connected tools realistically and accurately.\n- Provide actionable answers and offer intelligent next steps.`;\n\n    const contents: any[] = [];\n    if (history && Array.isArray(history)) {\n      for (const msg of history) {\n        contents.push({\n          role: msg.role === \"assistant\" ? \"model\" : \"user\",\n          parts: [{ text: msg.content }],\n        });\n      }\n    }\n\n    contents.push({\n      role: \"user\",\n      parts: [{ text: prompt }],\n    });\n\n    const response = await ai.models.generateContent({\n      model: \"gemini-3.7-flash\",\n      contents: contents,\n      config: {\n        systemInstruction: systemPrompt,\n        tools: [{ googleSearch: {} }],\n        temperature: 0.65,\n      },\n    });\n\n    const answer = response.text || \"I was unable to generate a response. Please try again.\";\n    const chunks = response.candidates?.[0]?.groundingMetadata?.groundingChunks || [];\n    const sources = chunks\n      .map((c: any) => c.web)\n      .filter((w: any) => w && w.uri && w.title);\n\n    return res.json({\n      answer,\n      toolsUsed,\n      sources,\n    });\n  } catch (err: any) {\n    console.error(\"Gemini Error:\", err);\n    return res.status(500).json({\n      error: err.message || \"Failed to process chat query\",\n      fallback: true,\n      answer: `I encountered an issue connecting to the inference engine: ${err.message}. Please check your connection or try again.`,\n    });\n  }\n});\n\n// Run Routine endpoint\napp.post(\"/api/routines/run\", async (req, res) => {\n  const { routineId, routineName, prompt } = req.body;\n  const ai = getAI();\n\n  const mockRunResult = `### Routine Execution Summary: ${routineName}\n- **Status**: Completed successfully in 1.4s\n- **Trigger**: ${routineName} automated schedule\n- **Data Extracted**:\n  - Google Calendar: 3 events reviewed\n  - Slack: 4 unread priority threads synthesized\n  - Linear: 2 blocking issues highlighted (LB-104, LB-98)\n- **Generated Action**: Digest dispatched to #littlebird-daily and saved in Meeting Notes.`;\n\n  if (!ai) {\n    return res.json({ result: mockRunResult, success: true });\n  }\n\n  try {\n    const response = await ai.models.generateContent({\n      model: \"gemini-3.7-flash\",\n      contents: `Execute automated routine: \"${routineName}\". Prompt instructions: \"${prompt}\". User: gaman sai. Produce a crisp 3-bullet briefing and status output.`,\n      config: {\n        systemInstruction: \"You are the Littlebird Autonomous Routine Engine. Execute the scheduled workflow and output a concise executive report.\",\n      },\n    });\n\n    return res.json({\n      result: response.text || mockRunResult,\n      success: true,\n    });\n  } catch (err: any) {\n    return res.json({ result: mockRunResult, success: true });\n  }\n});\n\n// Global Search endpoint\napp.get(\"/api/search\", (req, res) => {\n  const q = String(req.query.q || \"\").toLowerCase();\n  \n  const allResults = [\n    { title: \"PRD: Real App Connectors\", source: \"Google Drive\", type: \"doc\", snippet: \"Two-way context injection for Slack, Notion, Drive, Linear, and Dropbox.\" },\n    { title: \"AI Agent Swarm Architecture Sync\", source: \"Google Calendar\", type: \"calendar\", snippet: \"Meeting with Alex, Sarah, and Elena at 4:00 PM today.\" },\n    { title: \"LB-104: Multi-tab window bar navigation\", source: \"Linear\", type: \"issue\", snippet: \"Desktop window bar with tabs, add button, and close controls.\" },\n    { title: \"Autonomous Agent Safety & Privacy Policy\", source: \"Notion\", type: \"wiki\", snippet: \"Zero data retention and encrypted OAuth token management.\" },\n    { title: \"#general: New desktop release announcement\", source: \"Slack\", type: \"chat\", snippet: \"Version 0.84.17 update rollout discussion.\" },\n    { title: \"Q3 Strategy & Autonomous Agent Roadmap.pdf\", source: \"Dropbox\", type: \"file\", snippet: \"Milestone timeline and quarterly budget breakdown.\" },\n    { title: \"PR #42: Add Littlebird Warm Theme & App Connectors\", source: \"GitHub\", type: \"code\", snippet: \"Merged clean cream/stone color palette and icon strip.\" },\n  ];\n\n  const filtered = q\n    ? allResults.filter(r => r.title.toLowerCase().includes(q) || r.snippet.toLowerCase().includes(q) || r.source.toLowerCase().includes(q))\n    : allResults;\n\n  res.json({ results: filtered });\n});\n\n// Vite / static file serving\nasync function startServer() {\n  if (process.env.NODE_ENV !== \"production\") {\n    const vite = await createViteServer({\n      server: { middlewareMode: true },\n      appType: \"spa\",\n    });\n    app.use(vite.middlewares);\n  } else {\n    const distPath = path.join(process.cwd(), \"dist\");\n    app.use(express.static(distPath));\n    app.get(\"*\", (_req, res) => {\n      res.sendFile(path.join(distPath, \"index.html\"));\n    });\n  }\n\n  app.listen(PORT, \"0.0.0.0\", () => {\n    console.log(`Littlebird Server running on http://0.0.0.0:${PORT}`);\n  });\n}\n\nstartServer();\n"
    }
