waiting\" | \"completed\" | \"error\";\n  tools: string[];\n  currentThought?: string;\n  metrics: {\n    tokensProcessed: number;\n    callsCount: number;\n  };\n}\n\nexport interface SimulationMessage {\n  id: string;\n  from: string;\n  to: string;\n  type: \"task_delegation\" | \"handoff\" | \"tool_call\" | \"final_answer\" | \"human_approval\";\n  content: string;\n  timestamp: string;\n  status: \"sent\" | \"processing\" | \"delivered\";\n}\n"
