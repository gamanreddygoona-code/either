n    dataItems: [\n      {\n        id: \"cal-1\",\n        title: \"AI Agent Swarm Architecture Sync\",\n        type: \"Calendar Event\",\n        updatedAt: \"Today, 4:00 PM - 4:45 PM\",\n        summary: \"Discussing real connector integration and multi-agent latency benchmarks with team.\",\n      },\n      {\n        id: \"cal-2\",\n        title: \"Weekly Product Strategy Review\",\n        type: \"Calendar Event\",\n        updatedAt: \"Tomorrow, 10:00 AM - 11:00 AM\",\n        summary: \"Reviewing Q3 sprint deliverables, user feedback, and Littlebird design polish.\",\n      },\n      {\n        id: \"cal-3\",\n        title: \"1-on-1 with Engineering Lead\",\n        type: \"Calendar Event\",\n        updatedAt: \"Friday, 2:30 PM\",\n        summary: \"Bi-weekly sync on full-stack architecture, Gemini grounding, and container deploy.\",\n      },\n    ],\n    authFields: [\n      { key: \"googleOAuth\", label: \"Connect with Google\", placeholder: \"Authorize Google Calendar\", type: \"oauth\" },\n    ],\n  },\n  {\n    id: \"gdrive\",\n    name: \"Google Drive\",\n    category: \"storage\",\n    icon: \"drive\",\n    brandColor: \"#0F9D58\",\n    description: \"Search Google Docs, Sheets, and Slides to ground AI reasoning in your company knowledge.\",\n    status: \"connected\",\n    connectedAccount: \"vijay.goona@gmail.com\",\n    lastSynced: \"5 mins ago\",\n    itemCount: 128,\n    dataItems: [\n      {\n        id: \"gdrv-1\",\n        title: \"Product Requirement Doc: Real App Connectors\",\n        type: \"Google Doc\",\n        updatedAt: \"Today, 1:40 PM\",\n        summary: \"Specifying two-way sync, OAuth token caching, and context injection into prompts.\",\n      },\n      {\n        id: \"gdrv-2\",\n        title: \"2026 SaaS Pricing & Competitor Matrix\",\n        type: \"Google Sheet\",\n        updatedAt: \"Aug 24\",\n        summary: \"Financial models, tier structures, and API usage breakdown.\",\n      },\n      {\n        id: \"gdrv-3\",\n        title: \"Agent Swarm Visual Architecture Deck\",\n        type: \"Google Slides\",\n        updatedAt: \"Aug 20\",\n        summary: \"Slide deck covering hierarchical supervisors, peer handoffs, and tool execution.\",\n      },\n    ],\n    authFields: [\n      { key: \"googleDriveOAuth\", label: \"Connect with Google Drive\", placeholder: \"Authorize Google Drive\", type: \"oauth\" },\n    ],\n  },\n  {\n    id: \"asana\",\n    name: \"Asana\",\n    category: \"productivity\",\n    icon: \"asana\",\n    brandColor: \"#F06A6A\",\n    description: \"Track project milestones, view task assignees, and create automatic action items.\",\n    status: \"connected\",\n    connectedAccount: \"Asana Workspace: Littlebird Core\",\n    lastSynced: \"12 mins ago\",\n    itemCount: 34,\n    dataItems: [\n      {\n        id: \"asn-1\",\n        title: \"Implement Live Connector Bar & Icon Strip\",\n        type: \"Task (In Progress)\",\n        updatedAt: \"Today, 11:30 AM\",\n        summary: \"Add interactive connector drawer, auth verification, and status badges.\",\n      },\n      {\n        id: \"asn-2\",\n        title: \"Refactor Theme to Warm Minimalist Beige\",\n        type: \"Task (Completed)\",\n        updatedAt: \"Today, 9:00 AM\",\n        summary: \"Align typography, button shapes, and input containers to Littlebird spec.\",\n      },\n      {\n        id: \"asn-3\",\n        title: \"Gemini 3.7 Flash Model Fallback & Streaming\",\n        type: \"Task (Review)\",\n        updatedAt: \"Aug 24\",\n        summary: \"Wire server-side streaming endpoints and error recovery.\",\n      },\n    ],\n    authFields: [\n      { key: \"asanaToken\", label: \"Personal Access Token\", placeholder: \"1/120...\", type: \"password\" },\n      { key: \"workspaceId\", label: \"Workspace ID\", placeholder: \"1203491029\", type: \"text\" },\n    ],\n  },\n  {\n    id: \"linear\",\n    name: \"Linear\",\n    category: \"productivity\",\n    icon: \"linear\",\n    brandColor: \"#5E6AD2\",\n    description: \"Manage engineering cycles, triage bugs, and sync issue descriptions into context.\",\n    status: \"connected\",\n    connectedAccount: \"team-littlebird.linear.app\",\n    lastSynced: \"3 mins ago\",\n    itemCount: 19,\n    dataItems: [\n      {\n        id: \"lin-1\",\n        title: \"LB-104: Multi-tab window bar navigation\",\n        type: \"Issue (In Progress)\",\n        updatedAt: \"Today, 3:10 PM\",\n        summary: \"Enable switching between multiple open chats, meeting notes, and routines with keyboard shortcuts.\",\n      },\n      {\n        id: \"lin-2\",\n        title: \"LB-98: Speech-to-Text Microphone integration\",\n        type: \"Issue (Ready)\",\n        updatedAt: \"Today, 10:00 AM\",\n        summary: \"Use browser Web Speech API for voice prompts with visual pulsing wave indicator.\",\n      },\n      {\n        id: \"lin-3\",\n        title: \"LB-82: Global semantic search across connected apps\",\n        type: \"Issue (Backlog)\",\n        updatedAt: \"Aug 23\",\n        summary: \"Search through Notion, Drive, Linear, and Slack from a single CMD+K bar.\",\n      },\n    ],\n    authFields: [\n      { key: \"linearApiKey\", label: \"Linear API Key\", placeholder: \"lin_api_...\", type: \"password\" },\n    ],\n  },\n  {\n    id: \"notion\",\n    name: \"Notion\",\n    category: \"productivity\",\n    icon: \"notion\",\n    brandColor: \"#000000\",\n    description: \"Read team wikis, engineering specs, product backlogs, and sync rich markdown pages.\",\n    status: \"connected\",\n    connectedAccount: \"Littlebird Knowledge Base\",\n    lastSynced: \"10 mins ago\",\n    itemCount: 56,\n    dataItems: [\n      {\n        id: \"not-1\",\n        title: \"Autonomous Agent Safety & Privacy Policy\",\n        type: \"Wiki Page\",\n        updatedAt: \"Today, 12:00 PM\",\n        summary: \"Data retention rules, zero-storage agreements, and sandboxing instructions.\",\n      },\n      {\n        id: \"not-2\",\n        title: \"Weekly Engineering Meeting Notes (Aug 26)\",\n        type: \"Database Record\",\n        updatedAt: \"Today, 8:45 AM\",\n        summary: \"Key decisions on Web Speech API, connector models, and multi-tab state.\",\n      },\n      {\n        id: \"not-3\",\n        title: \"Littlebird Prompt Engineering Playbook\",\n        type: \"Guide\",\n        updatedAt: \"Aug 21\",\n        summary: \"Best practices for multi-agent reasoning, role assignment, and tool definitions.\",\n      },\n    ],\n    authFields: [\n      { key: \"notionToken\", label: \"Internal Integration Secret\", placeholder: \"secret_...\", type: \"password\" },\n      { key: \"databaseId\", label: \"Database ID\", placeholder: \"32-char hex string\", type: \"text\" },\n    ],\n  },\n  {\n    id: \"slack\",\n    name: \"Slack\",\n    category: \"communication\",\n    icon: \"slack\",\n    brandColor: \"#4A154B\",\n    description: \"Fetch channel summaries, unread message digests, and direct mention notifications.\",\n    status: \"connected\",\n    connectedAccount: \"Workspace: #littlebird-dev\",\n    lastSynced: \"1 min ago\",\n    itemCount: 92,\n    dataItems: [\n      {\n        id: \"slk-1\",\n        title: \"#general: New desktop release announcement\",\n        type: \"Channel Thread\",\n        updatedAt: \"Today, 2:50 PM\",\n        summary: \"Discussion on v0.84.17 update, context engine improvements, and connector strip.\",\n      },\n      {\n        id: \"slk-2\",\n        title: \"#eng-agents: Real-time latency optimization\",\n        type: \"Channel Thread\",\n        updatedAt: \"Today, 1:15 PM\",\n        summary: \"Benchmarking Gemini 3.7 Flash vs Claude 3.5 Sonnet on multi-tool execution.\",\n      },\n      {\n        id: \"slk-3\",\n        title: \"DM from Sarah: Reviewed the UI layout mockup\",\n        type: \"Direct Message\",\n        updatedAt: \"Today, 10:45 AM\",\n        summary: \"Looks super crisp, make sure the prompt box + icon matches the reference.\",\n      },\n    ],\n    authFields: [\n      { key: \"slackBotToken\", label: \"Bot User OAuth Token\", placeholder: \"xoxb-...\", type: \"password\" },\n      { key: \"channels\", label: \"Watched Channels\", placeholder: \"general, eng-agents, support\", type: \"text\" },\n    ],\n  },\n  {\n    id: \"discord\",\n    name: \"Discord\",\n    category: \"communication\",\n    icon: \"discord\",\n    brandColor: \"#5865F2\",\n    description: \"Monitor developer community questions, feedback channels, and bug reports.\",\n    status: \"connected\",\n    connectedAccount: \"Server: Littlebird AI Community\",\n    lastSynced: \"8 mins ago\",\n    itemCount: 15,\n    dataItems: [\n      {\n        id: \"dsc-1\",\n        title: \"#feedback: Users loving the warm beige aesthetic\",\n        type: \"Message\",\n        updatedAt: \"Today, 12:40 PM\",\n        summary: \"Feedback praise for readable typography and clutter-free minimalist UI.\",\n      },\n      {\n        id: \"dsc-2\",\n        title: \"#agent-showcase: Custom research routines\",\n        type: \"Forum Post\",\n        updatedAt: \"Yesterday\",\n        summary: \"Community member sharing automated morning calendar + email prep routine.\",\n      },\n    ],\n    authFields: [\n      { key: \"discordBotToken\", label: \"Discord Bot Token\", placeholder: \"MTIz...\", type: \"password\" },\n      { key: \"guildId\", label: \"Guild / Server ID\", placeholder: \"98234...\", type: \"text\" },\n    ],\n  },\n  {\n    id: \"zapier\",\n    name: \"Zapier\",\n    category: \"automation\",\n    icon: \"zapier\",\n    brandColor: \"#FF4A00\",\n    description: \"Trigger cross-app automations, multi-step zaps, and CRM actions directly from prompt.\",\n    status: \"connected\",\n    connectedAccount: \"Zapier Account: Gaman Sai (Pro)\",\n    lastSynced: \"15 mins ago\",\n    itemCount: 6,\n    dataItems: [\n      {\n        id: \"zap-1\",\n        title: \"Zap #104: Meeting Notes -> Create Notion