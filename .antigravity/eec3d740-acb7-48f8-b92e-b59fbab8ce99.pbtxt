  file_change {
    absolute_path_uri: "file:///server.ts"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import express from \"express\";\nimport path from \"path\";\nimport { createServer as createViteServer } from \"vite\";\nimport { GoogleGenAI } from \"@google/genai\";\nimport dotenv from \"dotenv\";\n\ndotenv.config();\n\nconst app = express();\nconst PORT = 3000;\n\napp.use(express.json());\n\n// Initialize Gemini API client if API key is provided\nlet aiClient: GoogleGenAI | null = null;\nfunction getAI(): GoogleGenAI | null {\n  if (!aiClient && process.env.GEMINI_API_KEY) {\n    aiClient = new GoogleGenAI({\n      apiKey: process.env.GEMINI_API_KEY,\n      httpOptions: {\n        headers: {\n          \"User-Agent\": \"aistudio-build\",\n        },\n      },\n    });\n  }\n  return aiClient;\n}\n\n// Health check endpoint\napp.get(\"/api/health\", (_req, res) => {\n  res.json({\n    status: \"ok\",\n    hasApiKey: Boolean(process.env.GEMINI_API_KEY),\n    timestamp: new Date().toISOString(),\n  });\n});\n\n// AI Research Advisor endpoint using Gemini 3.7 Flash with Google Search grounding\napp.post(\"/api/research/query\", async (req, res) => {\n  const { query, context, history } = req.body;\n\n  if (!query) {\n    return res.status(400).json({ error: \"Query parameter is required\" });\n  }\n\n  const ai = getAI();\n  if (!ai) {\n    // Fallback response if API key is not present\n    return res.json({\n      answer: `### Swarm UI Research Advisor (Offline Analysis Mode)\n\nRegarding **${query}**:\n\n1. **Top Open-Source Swarm UIs**:\n   - **AutoGen Studio** (Microsoft): Ideal for declarative multi-agent workflows, skill libraries, and interactive multi-agent chat.\n   - **Agency Swarm Web UI / Copilot** (VRSEN): Best for ergonomic peer-to-peer handoffs and OpenAI Agents SDK integration.\n   - **Langflow & Flowise**: Leading visual drag-and-drop node graph canvas UIs for multi-agent DAGs and supervisor teams.\n   - **OpenHands Agent Canvas**: The gold standard for containerized coding agent swarms with terminal and file diff viewers.\n   - **Dify.ai**: Comprehensive enterprise-grade visual workflow platform supporting multi-agent collaboration with built-in RAG and toolsets.\n\n2. **Architectural Recommendation**:\n   - For **code-first developers**: Choose *Agency Swarm* or *CrewAI with Streamlit/Chainlit*.\n   - For **visual node builder fans**: Choose *Langflow* or *Dify*.\n   - For **coding & sandbox execution**: Choose *OpenHands*.\n\n*(Configure GEMINI_API_KEY in the Secrets panel to activate live web-grounded AI search and code generation).*`,\n      sources: [\n        { title: \"Agency Swarm GitHub\", uri: \"https://github.com/VRSEN/agency-swarm\" },\n        { title: \"AutoGen Studio Docs\", uri: \"https://microsoft.github.io/autogen/docs/autogen-studio\" },\n        { title: \"Langflow Official\", uri: \"https://www.langflow.org\" },\n        { title: \"OpenHands Workspace\", uri: \"https://github.com/All-Hands-AI/OpenHands\" },\n      ],\n    });\n  }\n\n  try {\n    const systemPrompt = `You are the Lead Multi-Agent Systems Architect and Swarm UI Specialist. \nYour goal is to provide deep, technically accurate, up-to-date research, comparisons, architecture breakdowns, and code snippets for free open-source User Interfaces (UIs) and visual platforms for AI Agent Swarms and Multi-Agent Orchestration.\nCover frameworks such as:\n- Agency Swarm (VRSEN/agency-swarm) - Copilot Web UI, TUI, OpenAI Agents SDK\n- AutoGen Studio (Microsoft AutoGen / Agent Framework)\n- Langflow (Visual multi-agent DAG canvas)\n- Dify.ai (Open-source LLM & multi-agent workflow visual builder)\n- CrewAI UIs (CrewAI-UI, CrewAI Studio, crewai_chat_ui)\n- OpenHands (formerly OpenDevin) Agent Canvas & workspace manager\n- AgentSwarms (visual swarm canvas)\n- Swarms Corporation (Enterprise multi-agent framework)\n- Chainlit & FastAgency (Conversational multi-agent UIs)\n- PicoAgents Web UI & VoltAgent\n\nFormat your responses with clear markdown, comparison tables where appropriate, pros/cons, terminal install commands, and architectural insights.`;\n\n    const contents: any[] = [];\n    if (history && Array.isArray(history)) {\n      for (const msg of history) {\n        contents.push({\n          role: msg.role === \"assistant\" ? \"model\" : \"user\",\n          parts: [{ text: msg.content }],\n        });\n      }\n    }\n\n    const currentPromptText = context \n      ? `Context on current Swarm UI focus:\\n${context}\\n\\nUser Question: ${query}`\n      : query;\n\n    contents.push({\n      role: \"user\",\n      parts: [{ text: currentPromptText }],\n    });\n\n    const response = await ai.models.generateContent({\n      model: \"gemini-3.7-flash\",\n      contents: contents,\n      config: {\n        systemInstruction: systemPrompt,\n        tools: [{ googleSearch: {} }],\n        temperature: 0.7,\n      },\n    });\n\n    const answer = response.text || \"No response received from Gemini.\";\n    const chunks = response.candidates?.[0]?.groundingMetadata?.groundingChunks || [];\n    const sources = chunks\n      .map((c: any) => c.web)\n      .filter((w: any) => w && w.uri && w.title);\n\n    return res.json({\n      answer,\n      sources,\n    });\n  } catch (error: any) {\n    console.error(\"Gemini API Error:\", error);\n    return res.status(500).json({\n      error: error.message || \"Failed to generate AI research report\",\n      fallback: true,\n    });\n  }\n});\n\n// Generate swarm configuration boilerplate endpoint\napp.post(\"/api/research/generate-config\", async (req, res) => {\n  const { framework, topology, agents, goal } = req.body;\n\n  const ai = getAI();\n  if (!ai) {\n    return res.json({\n      config: `# Example Boilerplate for ${framework || \"Agency Swarm\"}\n# Topology: ${topology || \"Hierarchical\"}\n# Goal: ${goal || \"Multi-Agent Research Task\"}\n\nfrom agency_swarm import Agency, Agent, set_openai_key\n\n# 1. Define Agents\nsupervisor = Agent(\n    name=\"SupervisorAgent\",\n    description=\"Coordinates task distribution and aggregates findings.\",\n    instructions=\"You are the lead coordinator. Delegate subtasks to Researcher and Analyst.\",\n    tools=[]\n)\n\nresearcher = Agent(\n    name=\"WebResearchAgent\",\n    description=\"Gathers relevant sources and summarizes key points.\",\n    instructions=\"Search for verified documents and deliver structured bullet points.\",\n    tools=[]\n)\n\n# 2. Define Communication Flows (Agency Chart)\nagency = Agency(\n    [\n        supervisor,\n        [supervisor, researcher], # Supervisor can communicate with Researcher\n    ],\n    shared_instructions=\"Collaborate to produce accurate, high-density outputs.\"\n)\n\nif __name__ == \"__main__\":\n    # Launch Web Demo Copilot UI\n    agency.copilot_demo()\n`,\n    });\n  }\n\n  try {\n    const prompt = `Generate production-ready, well-commented boilerplate configuration and setup code for:\nFramework: ${framework}\nTopology: ${topology}\nTarget Agents: ${JSON.stringify(agents || [])}\nProject Goal: ${goal || \"General Multi-Agent Swarm\"}\n\nProvide runnable Python or TypeScript code with Dockerfile or CLI launch instructions for its UI.`;\n\n    const response = await ai.models.generateContent({\n      model: \"gemini-3.7-flash\",\n      contents: prompt,\n      config: {\n        systemInstruction: \"You are an expert multi-agent framework architect. Output clean, runnable code with markdown code fences and setup instructions.\",\n      },\n    });\n\n    return res.json({ config: response.text });\n  } catch (error: any) {\n    return res.status(500).json({ error: error.message });\n  }\n});\n\n// Vite / static file serving\nasync function startServer() {\n  if (process.env.NODE_ENV !== \"production\") {\n    const vite = await createViteServer({\n      server: { middlewareMode: true },\n      appType: \"spa\",\n    });\n    app.use(vite.middlewares);\n  } else {\n    const distPath = path.join(process.cwd(), \"dist\");\n    app.use(express.static(distPath));\n    app.get(\"*\", (_req, res) => {\n      res.sendFile(path.join(distPath, \"index.html\"));\n    });\n  }\n\n  app.listen(PORT, \"0.0.0.0\", () => {\n    console.log(`Swarm UI Research Server running on http://0.0.0.0:${PORT}`);\n  });\n}\n\nstartServer();\n"
    }
