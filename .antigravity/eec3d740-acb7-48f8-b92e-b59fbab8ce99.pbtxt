  file_change {
    absolute_path_uri: "file:///src/components/MainChatView.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState, useRef, useEffect } from \"react\";\nimport { \n  Plus, \n  ChevronDown, \n  Mic, \n  MicOff, \n  ArrowUp, \n  X, \n  Sparkles, \n  Copy, \n  Check, \n  RotateCw, \n  Bot, \n  User, \n  ExternalLink, \n  Layers, \n  Globe, \n  ShieldCheck, \n  Paperclip,\n  CheckCircle2\n} from \"lucide-react\";\nimport { \n  AppIconRenderer, \n  DropboxIcon, \n  GoogleCalendarIcon, \n  GoogleDriveIcon, \n  AsanaIcon, \n  LinearIcon, \n  NotionIcon, \n  SlackIcon, \n  DiscordIcon, \n  ZapierIcon, \n  GitHubIcon, \n  LittlebirdLogo \n} from \"./ConnectorIcons\";\nimport { AppConnector, ChatMessage, UserProfile } from \"../types\";\n\ninterface MainChatViewProps {\n  messages: ChatMessage[];\n  onSendMessage: (content: string, model: string, attachments?: any[]) => Promise<void>;\n  isLoading: boolean;\n  connectors: AppConnector[];\n  onOpenConnector: (connectorId: string) => void;\n  user: UserProfile;\n}\n\nexport const MainChatView: React.FC<MainChatViewProps> = ({\n  messages,\n  onSendMessage,\n  isLoading,\n  connectors,\n  onOpenConnector,\n  user,\n}) => {\n  const [promptText, setPromptText] = useState(\"\");\n  const [selectedModel, setSelectedModel] = useState(\"Max\");\n  const [showModelDropdown, setShowModelDropdown] = useState(false);\n  const [isListening, setIsListening] = useState(false);\n  const [copiedIdx, setCopiedIdx] = useState<number | null>(null);\n  const [connectorBarDismissed, setConnectorBarDismissed] = useState(false);\n  const [showAttachmentMenu, setShowAttachmentMenu] = useState(false);\n  const [suggestionSet, setSuggestionSet] = useState(0);\n\n  const textareaRef = useRef<HTMLTextAreaElement>(null);\n  const messagesEndRef = useRef<HTMLDivElement>(null);\n  const recognitionRef = useRef<any>(null);\n\n  const modelOptions = [\n    { id: \"Max\", label: \"Max\", desc: \"Most capable Gemini 3.7 Flash reasoning & tool execution\" },\n    { id: \"Gemini 3.7 Flash\", label: \"Gemini 3.7 Flash\", desc: \"Ultra-fast response with Google Search grounding\" },\n    { id: \"Gemini Pro\", label: \"Gemini Pro\", desc: \"Deep multi-agent architecture synthesis\" },\n    { id: \"Thinking\", label: \"Thinking Mode\", desc: \"Extended step-by-step reasoning tree\" },\n  ];\n\n  // Suggestions sets that rotate with \"More suggestions\"\n  const suggestionSets = [\n    [\n      \"How is my data protected?\",\n      \"What are your capabilities?\",\n      \"Find popular decluttering methods online\",\n    ],\n    [\n      \"Summarize today\'s Google Calendar meetings & prep notes\",\n      \"Check Linear Cycle 24 open issues and PR #42\",\n      \"Draft a 3-bullet morning briefing for #general\",\n    ],\n    [\n      \"Compare Agency Swarm vs AutoGen Studio multi-agent handoffs\",\n      \"Explain zero-storage privacy policy for connected tools\",\n      \"Search Notion for prompt engineering playbook\",\n    ],\n  ];\n\n  const currentSuggestions = suggestionSets[suggestionSet % suggestionSets.length];\n\n  // Auto-scroll to bottom of chat\n  useEffect(() => {\n    messagesEndRef.current?.scrollIntoView({ behavior: \"smooth\" });\n  }, [messages, isLoading]);\n\n  // Adjust textarea height\n  useEffect(() => {\n    if (textareaRef.current) {\n      textareaRef.current.style.height = \"auto\";\n      textareaRef.current.style.height = `${Math.min(textareaRef.current.scrollHeight, 200)}px`;\n    }\n  }, [promptText]);\n\n  // Web Speech Recognition setup\n  useEffect(() => {\n    if (\"webkitSpeechRecognition\" in window || \"SpeechRecognition\" in window) {\n      const SpeechRecognition = (window as any).SpeechRecognition || (window as any).webkitSpeechRecognition;\n      const recognition = new SpeechRecognition();\n      recognition.continuous = false;\n      recognition.interimResults = true;\n      recognition.lang = \"en-US\";\n\n      recognition.onresult = (event: any) => {\n        const transcript = Array.from(event.results)\n          .map((result: any) => result[0].transcript)\n          .join(\"\");\n        setPromptText(transcript);\n      };\n\n      recognition.onerror = () => {\n        setIsListening(false);\n      };\n\n      recognition.onend = () => {\n        setIsListening(false);\n      };\n\n      recognitionRef.current = recognition;\n    }\n  }, []);\n\n  const toggleSpeechRecognition = () => {\n    if (!recognitionRef.current) {\n      alert(\"Speech recognition is not supported in your current browser.\");\n      return;\n    }\n\n    if (isListening) {\n      recognitionRef.current.stop();\n      setIsListening(false);\n    } else {\n      try {\n        recognitionRef.current.start();\n        setIsListening(true);\n      } catch (err) {\n        console.error(\"Speech recognition start failed:\", err);\n      }\n    }\n  };\n\n  const handleSend = async (customText?: string) => {\n    const text = customText || promptText;\n    if (!text.trim() || isLoading) return;\n\n    const queryToSend = text.trim();\n    setPromptText(\"\");\n    if (textareaRef.current) {\n      textareaRef.current.style.height = \"auto\";\n    }\n\n    await onSendMessage(queryToSend, selectedModel);\n  };\n\n  const handleKeyDown = (e: React.KeyboardEvent<HTMLTextAreaElement>) => {\n    if (e.key === \"Enter\" && !e.shiftKey) {\n      e.preventDefault();\n      handleSend();\n    }\n  };\n\n  const copyMessage = (content: string, idx: number) => {\n    navigator.clipboard.writeText(content);\n    setCopiedIdx(idx);\n    setTimeout(() => setCopiedIdx(null), 2000);\n  };\n\n  const isHomeView = messages.length === 0;\n\n  // Format today\'s date dynamically (e.g. \"Wednesday, August 26\")\n  const formattedDate = new Date().toLocaleDateString(\"en-US\", {\n    weekday: \"long\",\n    month: \"long\",\n    day: \"numeric\",\n  });\n\n  return (\n    <div className=\"flex-1 flex flex-col justify-between h-full max-w-4xl w-full mx-auto px-4 sm:px-8 py-6 select-text overflow-y-auto\">\n      {/* Home Landing View (Matching Screenshot Exact Layout) */}\n      {isHomeView ? (\n        <div className=\"flex-1 flex flex-col justify-center items-center py-10 space-y-7 animate-fadeIn\">\n          {/* Greeting Header */}\n          <div className=\"w-full text-left space-y-1\">\n            <h1 className=\"text-3xl sm:text-4xl font-normal text-stone-900 tracking-tight font-serif\">\n              What\'s the next step, {user.name.split(\" \")[0]}?\n            </h1>\n            <p className=\"text-sm font-medium text-stone-500\">\n              {formattedDate}\n            </p>\n          </div>\n\n          {/* Centered Large Prompt Input Box */}\n          <div className=\"w-full bg-white border border-[#ded7c8] hover:border-[#cfc6b4] focus-within:border-stone-400 focus-within:ring-2 focus-within:ring-stone-200/50 rounded-2xl p-4 transition-all shadow-xs flex flex-col justify-between min-h-[140px] relative\">\n            {/* Main Textarea */}\n            <textarea\n              id=\"main-prompt-input\"\n              ref={textareaRef}\n              value={promptText}\n              onChange={(e) => setPromptText(e.target.value)}\n              onKeyDown={handleKeyDown}\n              placeholder=\"Ask Littlebird\"\n              rows={2}\n              className=\"w-full bg-transparent text-base text-stone-900 placeholder-stone-400 resize-none focus:outline-none leading-relaxed\"\n            />\n\n            {/* Bottom Controls Bar Inside Prompt Box */}\n            <div className=\"flex items-center justify-between pt-2 mt-1\">\n              {/* Left Action Buttons */}\n              <div className=\"flex items-center space-x-1.5 relative\">\n                {/* Plus (+) Button */}\n                <button\n                  id=\"prompt-attachment-plus-btn\"\n                  onClick={() => setShowAttachmentMenu(!showAttachmentMenu)}\n                  className=\"w-8 h-8 rounded-lg bg-[#f5f1e8] hover:bg-[#eae4d7] text-stone-700 flex items-center justify-center transition-colors cursor-pointer\"\n                  title=\"Add attachment or tool context\"\n                >\n                  <Plus className=\"w-4 h-4\" />\n                </button>\n\n                {/* Attachment Dropdown Menu */}\n                {showAttachmentMenu && (\n                  <div className=\"absolute left-0 bottom-10 bg-white border border-[#ded7c8] rounded-xl shadow-xl p-2 w-56 space-y-1 z-40 text-xs text-stone-700 animate-fadeIn\">\n                    <button\n                      onClick={() => {\n                        setShowAttachmentMenu(false);\n                        onOpenConnector(\"gdrive\");\n                      }}\n                      className=\"w-full flex items-center space-x-2 px-2.5 py-1.5 rounded-lg hover:bg-[#f5f1e8] text-left\"\n                    >\n                      <GoogleDriveIcon className=\"w-4 h-4\" />\n                      <span>Attach Google Drive Doc</span>\n                    </button>\n                    <button\n                      onClick={() => {\n                        setShowAttachmentMenu(false);\n                        onOpenConnector(\"notion\");\n                      }}\n                      className=\"w-full flex items-center space-x-2 px-2.5 py-1.5 rounded-lg hover:bg-[#f5f1e8] text-left\"\n                    >\n                      <NotionIcon className=\"w-4 h-4\" />\n                      <span>Attach Notion Page</span>\n                    </button>\n                    <button\n                      onClick={() => {\n                        setShowAttachmentMenu(false);\n                        onOpenConnector(\"linear\");\n                      }}\n                      className=\"w-full flex items-center space-x-2 px-2.5 py-1.5 rounded-lg hover:bg-[#f5f1e8] text-left\"\n                    >\n                      <LinearIcon className=\"w-4 h-4\" />\n                      <span>Attach Linear Issue</span>\n                    </button>\n                    <button\n                      onClick={() => {\n                        setShowAttachmentMenu(false);\n                        setPromptText((prev) => prev + \" [Grounded in All Connected Apps]\");\n                      }}\n                      className=\"w-full flex items-center space-x-2 px-2.5 py-1.5 rounded-lg hover:bg-[#f5f1e8] text-left font-medium text-stone-900 border-t border-[#f0ebd9] mt-1 pt-1.5\"\n                    >\n                      <Sparkles className=\"w-4 h-4 text-amber-500\" />\n                      <span>Ground with All 10 Connectors</span>\n                    </button>\n                  </div>\n                )}\n              </div>\n\n              {/* Right Action Buttons: Model Selector, Mic, Send */}\n              <div className=\"flex items-center space-x-2\">\n                {/* Model Selector Dropdown */}\n                <div className=\"relative\">\n                  <button\n                    id=\"model-selector-dropdown-btn\"\n                    onClick={() => setShowModelDropdown(!showModelDropdown)}\n                    className=\"flex items-center space-x-1 px-2.5 py-1 rounded-lg text-xs font-medium text-stone-700 hover:bg-[#f5f1e8] transition-colors cursor-pointer\"\n                  >\n                    <span>{selectedModel}</span>\n                    <ChevronDown className=\"w-3.5 h-3.5 text-stone-400\" />\n                  </button>\n\n                  {showModelDropdown && (\n                    <div className=\"absolute right-0 bottom-8 bg-white border border-[#ded7c8] rounded-xl shadow-xl p-1.5 w-60 space-y-1 z-40 text-xs animate-fadeIn\">\n                      {modelOptions.map((opt) => (\n                        <button\n                          key={opt.id}\n                          onClick={() => {\n                            setSelectedModel(opt.label);\n                            setShowModelDropdown(false);\n                          }}\n                          className={`w-full text-left p-2 rounded-lg transition-colors ${\n                            selectedModel === opt.label\n                              ? \"bg-[#f5f1e8] font-bold text-stone-900\"\n                              : \"hover:bg-[#faf8f5] text-stone-700\"\n                          }`}\n                        >\n                          <div className=\"font-semibold text-stone-900\">{opt.label}</div>\n                          <div className=\"text-[10px] text-stone-500 leading-tight\">{opt.desc}</div>\n                        </button>\n                      ))}\n                    </div>\n                  )}\n                </div>\n\n                {/* Microphone Speech Button */}\n                <button\n                  id=\"voice-mic-btn\"\n                  onClick={toggleSpeechRecognition}\n                  className={`p-2 rounded-lg text-stone-600 hover:text-stone-900 hover:bg-[#f5f1e8] transition-colors cursor-pointer ${\n                    isListening ? \"bg-rose-100 text-rose-600 animate-pulse\" : \"\"\n                  }`}\n                  title={isListening ? \"Listening... (Click to stop)\" : \"Dictate voice prompt\"}\n                >\n                  {isListening ? (\n                    <MicOff className=\"w-4 h-4 text-rose-600\" />\n                  ) : (\n                    <Mic className=\"w-4 h-4\" />\n                  )}\n                </button>\n\n                {/* Send Button */}\n                <button\n                  id=\"send-prompt-btn\"\n                  onClick={() => handleSend()}\n                  disabled={!promptText.trim() || isLoading}\n                  className=\"w-8 h-8 rounded-full bg-stone-900 hover:bg-stone-800 disabled:opacity-30 text-white flex items-center justify-center transition-all shadow-xs cursor-pointer\"\n                  title=\"Send message\"\n                >\n                  <ArrowUp className=\"w-4 h-4\" />\n                </button>\n              </div>\n            </div>\n\n            {/* Connectors Strip Inside/Below Prompt Card */}\n            {!connectorBarDismissed && (\n              <div className=\"mt-3 pt-3 border-t border-[#f0ebd9] flex flex-col sm:flex-row sm:items-center justify-between gap-2 text-xs text-stone-500\">\n                <span className=\"text-[11px] font-medium text-stone-600\">\n                  Connect your apps to get better answers\n                </span>\n\n                {/* Real App Icons Strip */}\n                <div className=\"flex items-center space-x-2 overflow-x-auto py-0.5\">\n                  <button\n                    onClick={() => onOpenConnector(\"dropbox\")}\n                    className=\"p-1 rounded hover:bg-[#eee8dc] transition-transform hover:scale-110 cursor-pointer\"\n                    title=\"Dropbox (Files & Docs)\"\n                  >\n                    <DropboxIcon className=\"w-4 h-4\" />\n                  </button>\n\n                  <button\n                    onClick={() => onOpenConnector(\"gcalendar\")}\n                    className=\"p-1 rounded hover:bg-[#eee8dc] transition-transform hover:scale-110 cursor-pointer\"\n                    title=\"Google Calendar (31)\"\n                  >\n                    <GoogleCalendarIcon className=\"w-4 h-4\" />\n                  </button>\n\n                  <button\n                    onClick={() => onOpenConnector(\"gdrive\")}\n                    className=\"p-1 rounded hover:bg-[#eee8dc] transition-transform hover:scale-110 cursor-pointer\"\n                    title=\"Google Drive (Docs & Sheets)\"\n                  >\n                    <GoogleDriveIcon className=\"w-4 h-4\" />\n                  </button>\n\n                  <button\n                    onClick={() => onOpenConnector(\"asana\")}\n                    className=\"p-1 rounded hover:bg-[#eee8dc] transition-transform hover:scale-110 cursor-pointer\"\n                    title=\"Asana (Tasks & Milestones)\"\n                  >\n                    <AsanaIcon className=\"w-4 h-4\" />\n                  </button>\n\n                  <button\n                    onClick={() => onOpenConnector(\"linear\")}\n                    className=\"p-1 rounded hover:bg-[#eee8dc] transition-transform hover:scale-110 cursor-pointer\"\n                    title=\"Linear (Issue Tracking)\"\n                  >\n                    <LinearIcon className=\"w-4 h-4\" />\n                  </button>\n\n                  <button\n                    onClick={() => onOpenConnector(\"notion\")}\n                    className=\"p-1 rounded hover:bg-[#eee8dc] transition-transform hover:scale-110 cursor-pointer\"\n                    title=\"Notion (Wikis & Databases)\"\n                  >\n                    <NotionIcon className=\"w-4 h-4\" />\n                  </button>\n\n                  <button\n                    onClick={() => onOpenConnector(\"slack\")}\n                    className=\"p-1 rounded hover:bg-[#eee8dc] transition-transform hover:scale-110 cursor-pointer\"\n                    title=\"Slack (Channels & Threads)\"\n                  >\n                    <SlackIcon className=\"w-4 h-4\" />\n                  </button>\n\n                  <button\n                    onClick={() => onOpenConnector(\"discord\")}\n                    className=\"p-1 rounded hover:bg-[#eee8dc] transition-transform hover:scale-110 cursor-pointer\"\n                    title=\"Discord (Developer Community)\"\n                  >\n                    <DiscordIcon className=\"w-4 h-4\" />\n                  </button>\n\n                  <button\n                    onClick={() => onOpenConnector(\"zapier\")}\n                    className=\"p-1 rounded hover:bg-[#eee8dc] transition-transform hover:scale-110 cursor-pointer\"\n                    title=\"Zapier (Automations)\"\n                  >\n                    <ZapierIcon className=\"w-4 h-4\" />\n                  </button>\n\n                  <button\n                    onClick={() => onOpenConnector(\"github\")}\n                    className=\"p-1 rounded hover:bg-[#eee8dc] transition-transform hover:scale-110 cursor-pointer\"\n                    title=\"GitHub (Repositories & PRs)\"\n                  >\n                    <GitHubIcon className=\"w-4 h-4\" />\n                  </button>\n\n                  {/* Dismiss Close Icon */}\n                  <button\n                    onClick={() => setConnectorBarDismissed(true)}\n                    className=\"p-0.5 text-stone-400 hover:text-stone-700 rounded hover:bg-[#eee8dc] transition-colors\"\n                    title=\"Dismiss strip\"\n                  >\n                    <X className=\"w-3.5 h-3.5\" />\n                  </button>\n                </div>\n              </div>\n            )}\n          </div>\n\n          {/* Suggestion Prompt Chips */}\n          <div className=\"w-full flex flex-wrap items-center gap-2 pt-2\">\n            {currentSuggestions.map((sug, idx) => (\n              <button\n                key={idx}\n                onClick={() => handleSend(sug)}\n                className=\"px-4 py-2 bg-white hover:bg-[#f7f4ec] border border-[#ded7c8] text-stone-800 rounded-2xl text-xs sm:text-sm font-medium transition-all shadow-2xs cursor-pointer hover:border-stone-400\"\n              >\n                {sug}\n              </button>\n            ))}\n\n            <button\n              onClick={() => setSuggestionSet((prev) => prev + 1)}\n              className=\"px-3 py-2 bg-transparent hover:bg-[#f0ebd9] text-stone-600 rounded-2xl text-xs sm:text-sm font-medium flex items-center space-x-1.5 transition-colors cursor-pointer\"\n            >\n              <Sparkles className=\"w-3.5 h-3.5 text-amber-500\" />\n              <span>More suggestions</span>\n            </button>\n          </div>\n        </div>\n      ) : (\n        /* Active Conversation Flow */\n        <div className=\"flex-1 flex flex-col space-y-6 pb-6\">\n          {messages.map((msg, idx) => {\n            const isUser = msg.role === \"user\";\n\n            return (\n              <div\n                key={msg.id || idx}\n                className={`flex items-start space-x-3.5 ${\n                  isUser ? \"flex-row-reverse space-x-reverse\" : \"flex-row\"\n                } animate-fadeIn`}\n              >\n                {/* Avatar */}\n                <div\n                  className={`w-8 h-8 rounded-full flex items-center justify-center shrink-0 shadow-xs ${\n                    isUser\n                      ? \"bg-gradient-to-tr from-purple-400 to-cyan-300 text-purple-900 font-bold text-xs\"\n                      : \"bg-stone-900 text-white\"\n                  }`}\n                >\n                  {isUser ? \"gs\" : <LittlebirdLogo className=\"w-4 h-4\" />}\n                </div>\n\n                {/* Message Content Bubble */}\n                <div\n                  className={`max-w-2xl rounded-2xl p-4 sm:p-5 text-sm leading-relaxed ${\n                    isUser\n                      ? \"bg-[#eee8dc] text-stone-900 rounded-tr-none font-medium\"\n                      : \"bg-white border border-[#ded7c8] text-stone-800 rounded-tl-none shadow-2xs space-y-3\"\n                  }`}\n                >\n                  {/* Tool Execution Badges if assistant used connected tools */}\n                  {!isUser && msg.toolsUsed && msg.toolsUsed.length > 0 && (\n                    <div className=\"space-y-1.5 pb-2 border-b border-[#f0ebd9]\">\n                      <span className=\"text-[10px] font-bold text-stone-500 uppercase tracking-wider flex items-center space-x-1\">\n                        <CheckCircle2 className=\"w-3 h-3 text-emerald-500\" />\n                        <span>Connected Tool Execution</span>\n                      </span>\n                      <div className=\"flex flex-wrap gap-1.5\">\n                        {msg.toolsUsed.map((tool, tIdx) => (\n                          <div\n                            key={tIdx}\n                            className=\"bg-[#f7f4ec] border border-[#ded7c8] px-2.5 py-1 rounded-lg text-xs flex items-center space-x-1.5 text-stone-700\"\n                          >\n                            <AppIconRenderer iconName={tool.icon} className=\"w-3.5 h-3.5\" />\n                            <span className=\"font-semibold text-[11px]\">{tool.name}</span>\n                          </div>\n                        ))}\n                      </div>\n                    </div>\n                  )}\n\n                  {/* Message Body */}\n                  <div className=\"prose prose-stone max-w-none text-xs sm:text-sm whitespace-pre-wrap leading-relaxed\">\n                    {msg.content}\n                  </div>\n\n                  {/* Grounding Sources */}\n                  {!isUser && msg.sources && msg.sources.length > 0 && (\n                    <div className=\"pt-2 border-t border-[#f0ebd9] space-y-1\">\n                      <span className=\"text-[10px] font-semibold text-stone-500 flex items-center space-x-1\">\n                        <Globe className=\"w-3 h-3 text-cyan-600\" />\n                        <span>Verified Context Grounding:</span>\n                      </span>\n                      <div className=\"flex flex-wrap gap-1.5\">\n                        {msg.sources.map((s, sIdx) => (\n                          <a\n                            key={sIdx}\n                            href={s.uri}\n                            target=\"_blank\"\n                            rel=\"noreferrer\"\n                            className=\"px-2 py-0.5 bg-[#f7f4ec] hover:bg-[#eee8dc] border border-[#ded7c8] text-stone-700 rounded-md text-[10px] flex items-center space-x-1 transition-colors\"\n                          >\n                            <span className=\"truncate max-w-[180px]\">{s.title}</span>\n                            <ExternalLink className=\"w-2.5 h-2.5 shrink-0\" />\n                          </a>\n                        ))}\n                      </div>\n                    </div>\n                  )}\n\n                  {/* Copy button */}\n                  {!isUser && (\n                    <div className=\"flex justify-end pt-1\">\n                      <button\n                        onClick={() => copyMessage(msg.content, idx)}\n                        className=\"text-stone-400 hover:text-stone-700 text-[11px] flex items-center space-x-1 cursor-pointer\"\n                      >\n                        {copiedIdx === idx ? (\n                          <Check className=\"w-3 h-3 text-emerald-600\" />\n                        ) : (\n                          <Copy className=\"w-3 h-3\" />\n                        )}\n                        <span>{copiedIdx === idx ? \"Copied\" : \"Copy\"}</span>\n                      </button>\n                    </div>\n                  )}\n                </div>\n              </div>\n            );\n          })}\n\n          {/* Loading Indicator */}\n          {isLoading && (\n            <div className=\"flex items-start space-x-3.5 animate-fadeIn\">\n              <div className=\"w-8 h-8 rounded-full bg-stone-900 text-white flex items-center justify-center shrink-0\">\n                <LittlebirdLogo className=\"w-4 h-4\" />\n              </div>\n              <div className=\"bg-white border border-[#ded7c8] rounded-2xl rounded-tl-none p-4 text-xs text-stone-600 flex items-center space-x-2\">\n                <RotateCw className=\"w-4 h-4 animate-spin text-stone-500\" />\n                <span className=\"animate-pulse font-medium\">\n                  Littlebird reasoning with connected enterprise tools...\n                </span>\n              </div>\n            </div>\n          )}\n\n          <div ref={messagesEndRef} />\n        </div>\n      )}\n\n      {/* Bottom Pinned Prompt Input for ongoing conversations */}\n      {!isHomeView && (\n        <div className=\"sticky bottom-0 bg-[#faf8f5]/90 backdrop-blur-xs pt-3 pb-2 z-20\">\n          <div className=\"bg-white border border-[#ded7c8] hover:border-stone-400 rounded-2xl p-3 shadow-sm flex flex-col justify-between\">\n            <textarea\n              ref={textareaRef}\n              value={promptText}\n              onChange={(e) => setPromptText(e.target.value)}\n              onKeyDown={handleKeyDown}\n              placeholder=\"Ask Littlebird...\"\n              rows={1}\n              className=\"w-full bg-transparent text-sm text-stone-900 placeholder-stone-400 resize-none focus:outline-none\"\n            />\n\n            <div className=\"flex items-center justify-between pt-2 border-t border-[#f0ebd9] mt-2\">\n              <div className=\"flex items-center space-x-1.5\">\n                <button\n                  onClick={() => onOpenConnector(\"gdrive\")}\n                  className=\"p-1.5 rounded-lg bg-[#f5f1e8] hover:bg-[#eae4d7] text-stone-700 text-xs flex items-center space-x-1\"\n                >\n                  <Plus className=\"w-3.5 h-3.5\" />\n                  <span>Attach</span>\n                </button>\n                <span className=\"text-[10px] text-stone-400\">\n                  Model: <span className=\"font-semibold text-stone-700\">{selectedModel}</span>\n                </span>\n              </div>\n\n              <div className=\"flex items-center space-x-2\">\n                <button\n                  onClick={toggleSpeechRecognition}\n                  className={`p-1.5 rounded-lg text-stone-600 hover:text-stone-900 transition-colors ${\n                    isListening ? \"bg-rose-100 text-rose-600 animate-pulse\" : \"\"\n                  }`}\n                >\n                  {isListening ? <MicOff className=\"w-4 h-4 text-rose-600\" /> : <Mic className=\"w-4 h-4\" />}\n                </button>\n\n                <button\n                  onClick={() => handleSend()}\n                  disabled={!promptText.trim() || isLoading}\n                  className=\"w-7 h-7 rounded-full bg-stone-900 hover:bg-stone-800 disabled:opacity-30 text-white flex items-center justify-center transition-all cursor-pointer\"\n                >\n                  <ArrowUp className=\"w-3.5 h-3.5\" />\n                </button>\n              </div>\n            </div>\n          </div>\n        </div>\n      )}\n    </div>\n  );\n};\n"
    }
