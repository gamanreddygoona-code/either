{
  "manifest_version": 3,
  "name": "Either Browser Agent",
  "version": "0.84.17",
  "description": "Record clicks and fills → Puppeteer script for Either Workflow Builder",
  "permissions": ["activeTab", "scripting", "storage"],
  "action": { "defaultPopup": "popup.html", "defaultTitle": "Either Agent" },
  "content_scripts": [{ "matches": ["<all_urls>"], "js": ["content.js"] }],
  "background": { "service_worker": "background.js" }
}
